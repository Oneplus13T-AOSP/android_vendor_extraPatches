From a9cc19d67e10ee40c3cea68e1715f98e56d400e5 Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Thu, 12 Nov 2026 15:09:32 +0900
Subject: [PATCH] aidl: propagate ODM availability to Rust libraries

Rust bindings are generated by default. Unlike the C++/NDK backend, the
Rust backend drops odm_available, leaving ODM interfaces with no vendor
image variant. A vendor-available interface importing such an interface
then fails Soong variant resolution.

Forward the existing property to rust_library, which already supports
odm_available and uses it when deciding whether to create vendor variants.
Preserve ODM install placement and all enabled language backends.

Change-Id: I4cdf3582e7c04c8c60d445313b47e770244b8ed7
---
 build/aidl_interface_backends.go | 1 +
 build/properties.go              | 1 +
 2 files changed, 2 insertions(+)

diff --git a/build/aidl_interface_backends.go b/build/aidl_interface_backends.go
index 2c37a299..26176a6f 100644
--- a/build/aidl_interface_backends.go
+++ b/build/aidl_interface_backends.go
@@ -382,6 +382,7 @@ func addRustLibrary(mctx android.DefaultableHookContext, i *aidlInterface, versi
 		Defaults:           []string{"aidl-rust-module-defaults"},
 		Host_supported:     i.properties.Host_supported,
 		Vendor_available:   i.properties.Vendor_available,
+		Odm_available:      i.properties.Odm_available,
 		Product_available:  i.properties.Product_available,
 		Recovery_available: i.properties.Recovery_available,
 		Apex_available:     i.properties.Backend.Rust.Apex_available,
diff --git a/build/properties.go b/build/properties.go
index 9adb9b24..3ec875c0 100644
--- a/build/properties.go
+++ b/build/properties.go
@@ -104,6 +104,7 @@ type rustProperties struct {
 	Defaults           []string
 	Host_supported     *bool
 	Vendor_available   *bool
+	Odm_available      *bool
 	Product_available  *bool
 	Recovery_available *bool
 	Srcs               []string
-- 
2.56.1

