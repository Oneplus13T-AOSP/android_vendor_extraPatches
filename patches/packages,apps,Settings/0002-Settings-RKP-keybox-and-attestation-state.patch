+     * caches the certificates it already fetched for its attestation keys, so a stale
+     * process keeps reporting the previous verdict until it is restarted.
+     */
+    private void killPackages() {
+        try {
+            android.app.ActivityManager am = (android.app.ActivityManager)
+                    getContext().getSystemService(Context.ACTIVITY_SERVICE);
+            if (am == null) return;
+            for (String pkg : new String[] {
+                    "com.google.android.gms", "com.android.vending" }) {
+                am.getClass().getMethod("forceStopPackage", String.class).invoke(am, pkg);
