+    /**
+     * Reports the registration state, not just the configured summary. The single
+     * biggest source of misdiagnosed Play Integrity failures is a keybox that looks
+     * configured in the UI but is absent from Settings.Secure, so the state is read
+     * back from the same value the framework consumes.
+     */
+    private CharSequence describeState() {
+        String xml = Settings.Secure.getString(getContext().getContentResolver(),
+                Settings.Secure.KEYBOX_DATA);
+        if (xml == null || xml.trim().isEmpty()) {
+            return getContext().getString(R.string.keybox_data_state_missing);
+        }
+        int certs = 0;
+        try {
+            XmlPullParser parser = XmlPullParserFactory.newInstance().newPullParser();
+            parser.setInput(new StringReader(xml));
+            for (int eventType = parser.next(); eventType != XmlPullParser.END_DOCUMENT;
+                    eventType = parser.next()) {
+                if (eventType == XmlPullParser.START_TAG
+                        && "Certificate".equals(parser.getName())) {
+                    certs++;
+                }
+            }
+        } catch (Exception ignored) {
+        }
+        return getContext().getString(R.string.keybox_data_state_loaded, xml.length(), certs);
+    }
