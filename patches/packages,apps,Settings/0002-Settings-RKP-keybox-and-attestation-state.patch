-                            if ("ecdsa".equalsIgnoreCase(currentAlg)) {
+                            if ("ecdsa".equalsIgnoreCase(currentAlg)
+                                    || "ec".equalsIgnoreCase(currentAlg)) {
+                                currentAlg = "ecdsa";
                                 hasEcdsaKey = true;
                             } else if ("rsa".equalsIgnoreCase(currentAlg)) {
+                                currentAlg = "rsa";
                                 hasRsaKey = true;
                             } else {
                                 currentAlg = null; // unsupported key
@@ -177,8 +225,13 @@ public class KeyboxDataPreference extends Preference {
             return false;
         }
 
-        return numberOfKeyboxes == 1
-                && hasEcdsaKey && hasEcdsaPrivKey && ecdsaCertCount >= 1
-                && hasRsaKey && hasRsaPrivKey && rsaCertCount >= 1;
+        // NumberOfKeyboxes is advisory in the framework parser: generators disagree on
+        // what it counts (boxes or keys) and some write a value matching neither, so a
+        // mismatch there is only logged. The importer must not be stricter than the
+        // code that consumes the file, or a keybox that would work on the device is
+        // rejected here. A document with no usable key is still rejected.
+        boolean hasEcdsa = hasEcdsaKey && hasEcdsaPrivKey && ecdsaCertCount >= 1;
+        boolean hasRsa = hasRsaKey && hasRsaPrivKey && rsaCertCount >= 1;
+        return hasEcdsa || hasRsa;
