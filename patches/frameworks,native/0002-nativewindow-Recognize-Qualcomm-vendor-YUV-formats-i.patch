From fe25547e7f15b3d18c16a7df86abaeaf90b79d1c Mon Sep 17 00:00:00 2001
From: realahnet <syedmusicrealise@gmail.com>
Date: Mon, 29 Jun 2026 01:01:32 +0500
Subject: [PATCH 02/16] nativewindow: Recognize Qualcomm vendor YUV formats in
 formatIsYuv
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The source-built Qualcomm gralloc resolves camera buffers to vendor-specific
YUV formats (e.g. YCbCr_420_SP_VENUS = 0x7FA30C04), but AOSP's
AHardwareBuffer_formatIsYuv() only recognized standard format values. This
caused AHardwareBuffer_lockPlanes() to return a single plane instead of three,
leaving planes[1] (chroma) and planes[2] (Cr) uninitialized.

Camera post-processing computes buffer height from the difference between
plane pointers divided by stride. With planes[1] uninitialized, this produces
garbage values that break P010 conversion, HDR tone mapping, and JPEG encoding
— resulting in green and distorted photos.

Add Qualcomm vendor YUV format constants to the switch so these buffers take
the multi-plane YUV lock path, which reads correct plane layout metadata
already provided by the gralloc.

Change-Id: I0fee9cb533f5ab3496f43c4d4e9a34c3dbc7daed
---
 libs/nativewindow/AHardwareBuffer.cpp | 16 ++++++++++++++++
 libs/nativewindow/Android.bp          |  5 ++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/libs/nativewindow/AHardwareBuffer.cpp b/libs/nativewindow/AHardwareBuffer.cpp
index fa71a78..cfcc839 100644
--- a/libs/nativewindow/AHardwareBuffer.cpp
+++ b/libs/nativewindow/AHardwareBuffer.cpp
@@ -765,6 +765,22 @@ bool AHardwareBuffer_formatIsYuv(uint32_t format) {
         case AHARDWAREBUFFER_FORMAT_YCbCr_P010:
         case AHARDWAREBUFFER_FORMAT_YCbCr_P210:
             return true;
+#ifdef TARGET_SHIPS_OPLUS_CAM
+        // Qualcomm vendor YUV formats
+        case 0x7FA30C00:
+        case 0x7FA30C01:
+        case 0x7FA30C03:
+        case 0x7FA30C04:
+        case 0x7FA30C06:
+        case 0x7FA30C07:
+        case 0x7FA30C09:
+        case 0x7FA30C0A:
+        case 0x113:
+        case 0x114:
+        case 0x116:
+        case 0x124:
+            return true;
+#endif
         default:
             return false;
     }
diff --git a/libs/nativewindow/Android.bp b/libs/nativewindow/Android.bp
index 170c193..83cc29f 100644
--- a/libs/nativewindow/Android.bp
+++ b/libs/nativewindow/Android.bp
@@ -94,7 +94,10 @@ cc_library {
         "-Werror",
         "-Wno-enum-compare",
         "-Wno-unused-function",
-    ],
+    ] + select(soong_config_variable("camera", "target_ships_oplus_cam"), {
+        any @ value: ["-DTARGET_SHIPS_OPLUS_CAM"],
+        default: [],
+    }),
 
     version_script: "libnativewindow.map.txt",
 
