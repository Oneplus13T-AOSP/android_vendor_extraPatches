From fef5d7842f0371624c48591c41d554dd9834fb91 Mon Sep 17 00:00:00 2001
From: cjh1249131356 <cjh1249131356@gmail.com>
Date: Sun, 25 Sep 2022 14:56:49 +0800
Subject: [PATCH] sepolicy: Label LinearmotorVibratorService

Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 common/private/service.te       | 3 +++
 common/private/service_contexts | 3 +++
 common/private/system_server.te | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/common/private/service.te b/common/private/service.te
index 86f6e4c..e566241 100644
--- a/common/private/service.te
+++ b/common/private/service.te
@@ -5,3 +5,6 @@ type lineage_globalactions_service, system_api_service, system_server_service, s
 type lineage_livedisplay_service, system_api_service, system_server_service, service_manager_type;
 type lineage_profile_service, system_api_service, system_server_service, service_manager_type;
 type lineage_trust_service, system_api_service, system_server_service, service_manager_type;
+
+# Linearmotor Vibrator
+type linearmotor_vibrator_service, system_api_service, system_server_service, service_manager_type;
diff --git a/common/private/service_contexts b/common/private/service_contexts
index cd984cb..bd6bea8 100644
--- a/common/private/service_contexts
+++ b/common/private/service_contexts
@@ -6,3 +6,6 @@ lineagetrust                              u:object_r:lineage_trust_service:s0
 profile                                   u:object_r:lineage_profile_service:s0
 
 adbroot_service                           u:object_r:adbroot_service:s0
+
+# Linearmotor Vibrator
+linearmotor                               u:object_r:linearmotor_vibrator_service:s0
diff --git a/common/private/system_server.te b/common/private/system_server.te
index d2fbdf5..b73b32b 100644
--- a/common/private/system_server.te
+++ b/common/private/system_server.te
@@ -13,3 +13,6 @@ get_prop(system_server, camera2_extensions_prop)
 
 # Let system server toggle xtra-daemon
 set_prop(system_server, xtra_control_prop)
+
+# Linearmotor Vibrator
+add_service(system_server, linearmotor_vibrator_service);
