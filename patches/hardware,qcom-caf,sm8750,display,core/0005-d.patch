+            std::string::npos) {
+          hw_udfps_index = static_cast<int>(i);
+        }
+      }
+      UdfpsV5Log("stage=strategy_result display=%llu gpu_fallback=1 core=%u "
+                 "hw_layer_count=%zu gpu_target=1 hw_udfps=%d hw_udfps_index=%d",
+                 static_cast<unsigned long long>(display_id_), static_cast<unsigned>(info.first),
+                 info.second.hw_layers.size(), hw_udfps_index >= 0, hw_udfps_index);
