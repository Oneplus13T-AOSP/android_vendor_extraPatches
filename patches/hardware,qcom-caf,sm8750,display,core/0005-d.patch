@@ -146,6 +188,22 @@ DisplayError Strategy::GetNextStrategy() {
   // Mark all application layers for GPU composition. Find GPU target buffer and store its index for
   // programming the hardware.
   LayerStack *layer_stack = disp_layer_stack_->stack;
+
+  if (UdfpsV5Enabled()) {
+    int input_udfps_index = -1;
+    for (size_t i = 0; i < layer_stack->layers.size(); ++i) {
+      if (layer_stack->layers[i]->layer_name.find("SurfaceView[UdfpsControllerOverlay]") !=
