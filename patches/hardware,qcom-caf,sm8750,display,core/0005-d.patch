+               layer_stack->layers.size(), disp_layer_stack_->stack_info.app_layer_count,
+               input_udfps_index >= 0, input_udfps_index);
+  }
   for (uint32_t i = 0; i < disp_layer_stack_->stack_info.app_layer_count; i++) {
