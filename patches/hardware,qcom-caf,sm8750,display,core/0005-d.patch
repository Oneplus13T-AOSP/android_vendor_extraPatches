--- a/sde-drm/drm_atomic_req.cpp
+++ b/sde-drm/drm_atomic_req.cpp
@@ -70,6 +70,48 @@
  * SPDX-License-Identifier: BSD-3-Clause-Clear
  */
 
+
+// Temporary diagnostic only. Remove before release.
+// No cached gate or shared diagnostic state: enable explicitly for the repro window.
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <sys/system_properties.h>
+#include <time.h>
+#include <unistd.h>
+#include <log/log.h>
+
+namespace {
+static bool UdfpsV5Enabled() {
+  const int saved_errno = errno;
+  char value[PROP_VALUE_MAX] = {};
+  __system_property_get("debug.sf.udfps_diag", value);
+  const bool enabled = value[0] == '1' && value[1] == '\0';
+  errno = saved_errno;
+  return enabled;
+}
+
+static void UdfpsV5Log(const char *format, ...) __attribute__((format(printf, 1, 2)));
+static void UdfpsV5Log(const char *format, ...) {
+  const int saved_errno = errno;
+  if (UdfpsV5Enabled()) {
+    struct timespec now = {};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    char message[3072];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    __android_log_print(ANDROID_LOG_INFO, "UDFPS_DIAG",
+                        "UDFPS_DIAG version=5 ts=%lld pid=%d cycle=unknown %s",
+                        static_cast<long long>(now.tv_sec) * 1000000000LL + now.tv_nsec,
+                        static_cast<int>(getpid()), message);
+  }
+  errno = saved_errno;
+}
+}  // namespace
+
 #include <drm_logger.h>
 
 #include "drm_atomic_req.h"
@@ -87,6 +129,9 @@ DRMAtomicReq::DRMAtomicReq(int fd, DRMManager *drm_mgr) : drm_mgr_(drm_mgr), fd_
 
