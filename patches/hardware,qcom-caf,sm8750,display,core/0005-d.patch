   }
@@ -95,6 +140,9 @@ DRMAtomicReq::~DRMAtomicReq() {
 int DRMAtomicReq::Init(const DRMDisplayToken &tok) {
   token_ = tok;
   drm_atomic_req_ = drmModeAtomicAlloc();
+
+  UdfpsV5Log("stage=request_alloc req=%p conn_id=%u cursor=0",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id);
   if (!drm_atomic_req_) {
     return -ENOMEM;
   }
@@ -244,8 +292,16 @@ int DRMAtomicReq::Validate() {
   // because we just want to validate, not actually mark planes as removed
   drm_mgr_->GetPlaneMgr()->UnsetUnusedResources(token_.crtc_id, false/*is_commit*/,
                                                 drm_atomic_req_);
+  UdfpsV5Log("stage=submit_begin phase=validate req=%p conn_id=%u flags=0x%x cursor=%d "
+             "fp_included=offline fp_value=offline",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id,
+             static_cast<unsigned>(DRM_MODE_ATOMIC_ALLOW_MODESET | DRM_MODE_ATOMIC_TEST_ONLY), drmModeAtomicGetCursor(drm_atomic_req_));
   int ret = drmModeAtomicCommit(fd_, drm_atomic_req_,
                                 DRM_MODE_ATOMIC_ALLOW_MODESET | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
+  const int diag_ioctl_errno = errno;
+  UdfpsV5Log("stage=submit_end phase=validate req=%p conn_id=%u ioctl_rc=%d errno_raw=%d",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id, ret, diag_ioctl_errno);
+  errno = diag_ioctl_errno;
   if (ret) {
     DRM_LOGE("drmModeAtomicCommit failed with error %d (%s).", errno, strerror(errno));
   }
@@ -253,6 +309,8 @@ int DRMAtomicReq::Validate() {
   drm_mgr_->GetPlaneMgr()->PostValidate(token_.crtc_id, !ret);
   drm_mgr_->GetCrtcMgr()->PostValidate(token_.crtc_id, !ret);
   drmModeAtomicSetCursor(drm_atomic_req_, 0);
+  UdfpsV5Log("stage=request_reset phase=validate req=%p conn_id=%u cursor=0 cursor_reset=1",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id);
 
   return ret;
 }
@@ -273,7 +331,15 @@ int DRMAtomicReq::Commit(bool synchronous, bool retain_planes) {
     flags |= DRM_MODE_ATOMIC_NONBLOCK;
   }
 
+  UdfpsV5Log("stage=submit_begin phase=commit req=%p conn_id=%u flags=0x%x cursor=%d "
+             "fp_included=offline fp_value=offline",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id,
+             static_cast<unsigned>(flags), drmModeAtomicGetCursor(drm_atomic_req_));
   int ret = drmModeAtomicCommit(fd_, drm_atomic_req_, flags, nullptr);
+  const int diag_ioctl_errno = errno;
+  UdfpsV5Log("stage=submit_end phase=commit req=%p conn_id=%u ioctl_rc=%d errno_raw=%d",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id, ret, diag_ioctl_errno);
+  errno = diag_ioctl_errno;
   if (ret) {
     DRM_LOGE("drmModeAtomicCommit failed with error %d (%s). crtc=%u", errno, strerror(errno), token_.crtc_id);
   }
@@ -281,6 +347,8 @@ int DRMAtomicReq::Commit(bool synchronous, bool retain_planes) {
   drm_mgr_->GetPlaneMgr()->PostCommit(token_.crtc_id, !ret);
   drm_mgr_->GetCrtcMgr()->PostCommit(token_.crtc_id, !ret);
   drmModeAtomicSetCursor(drm_atomic_req_, 0);
+  UdfpsV5Log("stage=request_reset phase=commit req=%p conn_id=%u cursor=0 cursor_reset=1",
+             static_cast<void *>(drm_atomic_req_), token_.conn_id);
 
   return ret;
 }
