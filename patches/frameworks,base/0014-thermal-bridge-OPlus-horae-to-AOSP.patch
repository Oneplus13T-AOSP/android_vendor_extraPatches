+package com.android.server.power.thermal;
+
+import android.os.Binder;
+import android.os.Parcel;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.Temperature;
+
+import com.android.internal.annotations.VisibleForTesting;
+
+import java.util.function.Consumer;
+import java.util.function.IntSupplier;
+
+/** Binder extension used by the OPlus horae surface-temperature estimator. */
+final class OplusThermalService extends Binder {
+    static final String DESCRIPTOR = "android.os.IOplusThermalService";
+    static final String SENSOR_NAME = "horae_skin";
+    private static final int UPDATE_SKIN_AIDL = FIRST_CALL_TRANSACTION;
+    private static final int UPDATE_SKIN_NATIVE = 10001;
+
+    private final Consumer<Temperature> mCallback;
+    private final IntSupplier mCallingUid;
+
+    OplusThermalService(Consumer<Temperature> callback) {
+        this(callback, Binder::getCallingUid);
+    }
+
+    @VisibleForTesting
+    OplusThermalService(Consumer<Temperature> callback, IntSupplier callingUid) {
+        attachInterface(null, DESCRIPTOR);
+        mCallback = callback;
+        mCallingUid = callingUid;
+    }
+
+    @Override
+    protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        if (code != UPDATE_SKIN_AIDL && code != UPDATE_SKIN_NATIVE) {
+            return super.onTransact(code, data, reply, flags);
+        }
+        // horae runs as AID_SYSTEM. Do not expose thermal state injection to apps.
+        if (mCallingUid.getAsInt() != Process.SYSTEM_UID) {
+            throw new SecurityException("Only the system UID may report horae temperatures");
+        }
+        data.enforceInterface(DESCRIPTOR);
+        if (data.dataAvail() != 2 * Integer.BYTES) {
+            throw new IllegalArgumentException("Expected horae temperature and status");
+        }
+        final int temperature = data.readInt();
+        final int status = data.readInt();
+        data.enforceNoDataAvail();
+        updateSkinThermalStatus(temperature, status);
+        // The native client uses a synchronous transaction with an empty reply;
+        // the AIDL client uses the same payload in a one-way transaction.
+        return true;
+    }
+
+    @VisibleForTesting
+    void updateSkinThermalStatus(int temperature, int status) {
+        if (!Temperature.isValidStatus(status)) {
+            throw new IllegalArgumentException("Invalid horae thermal status: " + status);
+        }
+        // The stock Binder protocol uses integer degrees Celsius and Android's
+        // 0..6 severities, not the raw milli-Celsius / OEM policy-level values.
+        // Keep HAL skin sensors under their own names so a lower horae report
+        // cannot replace a more severe HAL report in the existing max reducer.
+        mCallback.accept(new Temperature(temperature, Temperature.TYPE_SKIN, SENSOR_NAME, status));
+    }
+}
