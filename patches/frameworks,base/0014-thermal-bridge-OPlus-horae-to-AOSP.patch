+package com.android.server.power.thermal;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.Process;
+import android.os.Temperature;
+
+import org.junit.Test;
+
+import java.util.concurrent.atomic.AtomicReference;
+
+public class OplusThermalServiceTest {
+    private final AtomicReference<Temperature> mReport = new AtomicReference<>();
+
+    private OplusThermalService service(int uid) {
+        return new OplusThermalService(mReport::set, () -> uid);
+    }
+
+    private Parcel request(String descriptor, int... args) {
+        Parcel parcel = Parcel.obtain();
+        parcel.writeInterfaceToken(descriptor);
+        for (int arg : args) {
+            parcel.writeInt(arg);
+        }
+        parcel.setDataPosition(0);
+        return parcel;
+    }
+
+    @Test
+    public void nativeSynchronousTransaction() throws Exception {
+        Parcel data = request(OplusThermalService.DESCRIPTOR, 42, Temperature.THROTTLING_MODERATE);
+        Parcel reply = Parcel.obtain();
+        try {
+            assertTrue(service(Process.SYSTEM_UID).onTransact(10001, data, reply, 0));
+            Temperature report = mReport.get();
+            assertNotNull(report);
+            assertEquals(42f, report.getValue(), 0f);
+            assertEquals(Temperature.TYPE_SKIN, report.getType());
+            assertEquals("horae_skin", report.getName());
+            assertEquals(Temperature.THROTTLING_MODERATE, report.getStatus());
+            assertEquals(0, reply.dataSize());
+        } finally {
+            data.recycle();
+            reply.recycle();
+        }
+    }
+
+    @Test
+    public void aidlOneWayTransaction() throws Exception {
+        Parcel data = request(OplusThermalService.DESCRIPTOR, 35, Temperature.THROTTLING_NONE);
+        try {
+            assertTrue(service(Process.SYSTEM_UID).onTransact(1, data, null, IBinder.FLAG_ONEWAY));
+            assertEquals(35f, mReport.get().getValue(), 0f);
+            assertEquals(Temperature.THROTTLING_NONE, mReport.get().getStatus());
+        } finally {
+            data.recycle();
+        }
+    }
+
+    @Test
+    public void nonSystemCallersAreRejected() {
+        for (int uid : new int[]{0, Process.SHELL_UID, 10042}) {
+            for (int code : new int[]{1, 10001}) {
+                Parcel data = request(OplusThermalService.DESCRIPTOR, 40, 2);
+                try {
+                    assertThrows(SecurityException.class,
+                            () -> service(uid).onTransact(code, data, null, IBinder.FLAG_ONEWAY));
+                    assertNull(mReport.get());
+                } finally {
+                    data.recycle();
+                }
+            }
+        }
+    }
+
+    @Test
+    public void wrongInterfaceTokenIsRejected() {
+        Parcel data = request("android.os.IThermalService", 40, 2);
+        try {
+            assertThrows(SecurityException.class,
+                    () -> service(Process.SYSTEM_UID).onTransact(10001, data, null, 0));
+            assertNull(mReport.get());
+        } finally {
+            data.recycle();
+        }
+    }
+
+    @Test
+    public void truncatedAndOversizedPayloadsAreRejected() {
+        for (int[] args : new int[][]{{}, {40}, {40, 2, 99}}) {
+            Parcel data = request(OplusThermalService.DESCRIPTOR, args);
+            try {
+                assertThrows(IllegalArgumentException.class,
+                        () -> service(Process.SYSTEM_UID).onTransact(10001, data, null, 0));
+                assertNull(mReport.get());
+            } finally {
+                data.recycle();
+            }
+        }
+    }
+
+    @Test
+    public void invalidSeverityIsRejected() {
+        for (int status : new int[]{-1, 7, 19, Integer.MAX_VALUE}) {
+            Parcel data = request(OplusThermalService.DESCRIPTOR, 40, status);
+            try {
+                assertThrows(IllegalArgumentException.class,
+                        () -> service(Process.SYSTEM_UID).onTransact(10001, data, null, 0));
+                assertNull(mReport.get());
+            } finally {
+                data.recycle();
+            }
+        }
+    }
+
+    @Test
+    public void allAndroidSeveritiesArePreserved() {
+        for (int status = Temperature.THROTTLING_NONE;
+                status <= Temperature.THROTTLING_SHUTDOWN; status++) {
+            service(Process.SYSTEM_UID).updateSkinThermalStatus(45, status);
+            assertEquals(status, mReport.get().getStatus());
+        }
+    }
+
+    @Test
+    public void descriptorAndUnknownTransactions() throws Exception {
+        OplusThermalService extension = service(Process.SYSTEM_UID);
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            assertTrue(extension.onTransact(IBinder.INTERFACE_TRANSACTION, data, reply, 0));
+            reply.setDataPosition(0);
+            assertEquals(OplusThermalService.DESCRIPTOR, reply.readString());
+            assertFalse(extension.onTransact(12345, data, null, 0));
+        } finally {
+            data.recycle();
+            reply.recycle();
+        }
+    }
+}
