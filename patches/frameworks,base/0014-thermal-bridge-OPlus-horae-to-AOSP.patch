+    @Test
+    public void testOplusExtensionOptIn() {
+        ThermalManagerService disabled = new ThermalManagerService(mContext, mFakeHal, false);
+        assertEquals(null, disabled.mService.getExtension());
+        ThermalManagerService enabled = new ThermalManagerService(mContext, mFakeHal, true);
+        assertTrue(enabled.mService.getExtension() instanceof OplusThermalService);
+    }
+
+    @Test
+    public void testOplusTemperaturePreservesHigherHalStatus() throws RemoteException {
+        mService = new ThermalManagerService(mContext, mFakeHal, true);
+        mService.onBootPhase(SystemService.PHASE_ACTIVITY_MANAGER_READY);
+        OplusThermalService extension = (OplusThermalService) mService.mService.getExtension();
+
+        mFakeHal.mCallback.onTemperatureChanged(new Temperature(49, Temperature.TYPE_SKIN,
+                "skin1", Temperature.THROTTLING_SEVERE));
+        extension.updateSkinThermalStatus(37, Temperature.THROTTLING_LIGHT);
+        assertEquals(Temperature.THROTTLING_SEVERE,
+                mService.mService.getCurrentThermalStatus());
+
+        extension.updateSkinThermalStatus(35, Temperature.THROTTLING_NONE);
+        assertEquals(Temperature.THROTTLING_SEVERE,
+                mService.mService.getCurrentThermalStatus());
+        mFakeHal.mCallback.onTemperatureChanged(new Temperature(34, Temperature.TYPE_SKIN,
+                "skin1", Temperature.THROTTLING_NONE));
+        assertEquals(Temperature.THROTTLING_NONE, mService.mService.getCurrentThermalStatus());
+    }
+
+    @Test
+    public void testOplusTemperatureRaisesStatusAndHalUpdatesCannotClearIt() throws RemoteException {
+        mService = new ThermalManagerService(mContext, mFakeHal, true);
+        mService.onBootPhase(SystemService.PHASE_ACTIVITY_MANAGER_READY);
+        OplusThermalService extension = (OplusThermalService) mService.mService.getExtension();
+        extension.updateSkinThermalStatus(45, Temperature.THROTTLING_MODERATE);
+        mFakeHal.mCallback.onTemperatureChanged(new Temperature(35, Temperature.TYPE_SKIN,
+                "skin1", Temperature.THROTTLING_NONE));
+        assertEquals(Temperature.THROTTLING_MODERATE,
+                mService.mService.getCurrentThermalStatus());
+        extension.updateSkinThermalStatus(33, Temperature.THROTTLING_NONE);
+        assertEquals(Temperature.THROTTLING_NONE, mService.mService.getCurrentThermalStatus());
+    }
+
