From 3251f69128356d6a9582d52e20cbb186e4d92984 Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Sun, 13 Sep 2026 18:34:36 +0900
Subject: [PATCH 7/7] ImageReader: Release OPlus HardwareBuffer holders through
 the platform factory

getOplusHardwareBuffer() allocates a strong GraphicBuffer holder and passes
it to the private HardwareBuffer(long, boolean) constructor. In this port
that constructor does not register a cleaner, while close() only runs an
existing cleaner. Closing these objects therefore loses the holder pointer
without releasing its strong reference.

The stock OnePlus framework explicitly calls its native finalizer from
HardwareBuffer.close(), even for objects constructed without a cleaner.
Its finalizer decrements the GraphicBuffer reference and deletes the holder.

Use android_hardware_HardwareBuffer_createFromAHardwareBuffer() instead.
The platform GraphicBufferWrapper contains the strong GraphicBuffer holder
expected by this path, and the regular Java constructor registers its
cleaner. Keep the existing OPlus entry point and null-buffer checks.

Validation: compared stock framework bytecode and native finalizer with
the local factory, wrapper, and close implementations; git diff --check.
ROM compilation and on-device validation have not been performed.

Change-Id: I00d241ce623f9278263ded89cda9b5ed397380e2
---
 core/jni/android_media_ImageReader.cpp | 23 ++++++-----------------
 1 file changed, 6 insertions(+), 17 deletions(-)

diff --git a/core/jni/android_media_ImageReader.cpp b/core/jni/android_media_ImageReader.cpp
index 0e059ba30393..33d7ec15f8d8 100644
--- a/core/jni/android_media_ImageReader.cpp
+++ b/core/jni/android_media_ImageReader.cpp
@@ -1055,12 +1055,10 @@ static jobject Image_getHardwareBuffer(JNIEnv* env, jobject thiz) {
 }
 
 #ifdef TARGET_SHIPS_OPLUS_CAM
-// OnePlus camera (APS) extension. Mirrors stock libandroid_runtime's
-// nativeGetOplusHardwareBuffer: hands back a HardwareBuffer whose native object is a
-// heap-allocated sp<GraphicBuffer> holder (NOT an AHardwareBuffer*), constructed via the
-// HardwareBuffer(long, boolean) ctor which skips AHardwareBuffer-based size/finalizer setup.
-// The OnePlus camera SDK reads mNativeObject expecting this sp<GraphicBuffer> layout; the
-// standard getHardwareBuffer() layout makes APS read a malformed camera_metadata size.
+// APS expects mNativeObject to point to a strong GraphicBuffer holder. The
+// platform HardwareBuffer factory already provides that layout and registers
+// the holder's cleaner. A bare sp<GraphicBuffer> passed to the (JZ) constructor
+// has no cleaner in this port and is leaked when HardwareBuffer.close() runs.
 static jobject Image_getOplusHardwareBuffer(JNIEnv* env, jobject thiz) {
     BufferItem* buffer = Image_getBufferItem(env, thiz);
     if (buffer == nullptr || buffer->mGraphicBuffer == nullptr) {
@@ -1068,17 +1066,8 @@ static jobject Image_getOplusHardwareBuffer(JNIEnv* env, jobject thiz) {
                 "Image is not initialized");
         return NULL;
     }
-    static jclass sHbClass = nullptr;
-    static jmethodID sHbHolderCtor = nullptr;
-    if (sHbClass == nullptr) {
-        jclass c = env->FindClass("android/hardware/HardwareBuffer");
-        sHbClass = (jclass) env->NewGlobalRef(c);
-        sHbHolderCtor = env->GetMethodID(sHbClass, "<init>", "(JZ)V");
-    }
-    // Strong-ref'd holder; lifetime owned by the OnePlus APS side (matches stock behavior).
-    sp<GraphicBuffer>* holder = new sp<GraphicBuffer>(buffer->mGraphicBuffer);
-    return env->NewObject(sHbClass, sHbHolderCtor,
-            reinterpret_cast<jlong>(holder), JNI_TRUE);
+    AHardwareBuffer* b = AHardwareBuffer_from_GraphicBuffer(buffer->mGraphicBuffer.get());
+    return android_hardware_HardwareBuffer_createFromAHardwareBuffer(env, b);
 }
 #endif  // TARGET_SHIPS_OPLUS_CAM
 #endif
