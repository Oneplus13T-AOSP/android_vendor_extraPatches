+            if (!actual.equals(expectedSha256)) throw new IOException("Font content changed");
+            validate(temporary, true);
+            File destination = fileFor(actual);
+            if (destination.exists()) {
+                if (!sha256(destination).equals(actual)) throw new IOException("Stored font is corrupt");
+            } else {
+                long retained = 0;
+                File[] existing = mDirectory.listFiles();
+                if (existing != null) for (File f : existing) retained += f.length();
+                if (retained > MAX_RETAINED_BYTES) {
