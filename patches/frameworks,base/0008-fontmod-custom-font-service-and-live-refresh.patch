+    }
+
+    private File fileFor(String id) { return new File(mDirectory, id + ".font"); }
+    private static boolean validId(String id) { return id != null && id.matches("[a-f0-9]{64}"); }
+
+    private static String sha256(File file) throws IOException {
+        if (!file.isFile() || file.length() < 12 || file.length() > MAX_BYTES) {
+            throw new IOException("Invalid font size");
+        }
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            try (FileInputStream in = new FileInputStream(file)) {
+                byte[] buffer = new byte[65536]; int n;
+                while ((n = in.read(buffer)) != -1) digest.update(buffer, 0, n);
+            }
+            StringBuilder hash = new StringBuilder(64);
+            for (byte b : digest.digest()) hash.append(String.format(Locale.ROOT, "%02x", b & 255));
+            return hash.toString();
+        } catch (java.security.NoSuchAlgorithmException e) { throw new AssertionError(e); }
+    }
+
+    private static void validate(File file, boolean render) throws IOException {
+        try (FileInputStream in = new FileInputStream(file)) {
+            byte[] magicBytes = in.readNBytes(4);
+            if (magicBytes.length != 4) throw new IOException("Missing font header");
+            int magic = ByteBuffer.wrap(magicBytes).getInt();
+            if (magic != 0x00010000 && magic != 0x4f54544f) {
+                throw new IOException("Only single-face TTF/OTF fonts are supported");
+            }
+        }
+        try {
+            Font font = new Font.Builder(file).build();
+            if (!render) return;
+            Typeface typeface = new Typeface.CustomFallbackBuilder(
+                    new FontFamily.Builder(font).build()).build();
+            Paint paint = new Paint(); paint.setTypeface(typeface); paint.setTextSize(24);
+            Bitmap bitmap = Bitmap.createBitmap(512, 80, Bitmap.Config.ALPHA_8);
+            try { new Canvas(bitmap).drawText("가나다 Aa 0123", 0, 40, paint); }
+            finally { bitmap.recycle(); }
+        } catch (RuntimeException e) { throw new IOException("Invalid font data", e); }
+    }
+
+    private void syncDirectory() throws android.system.ErrnoException {
+        FileDescriptor fd = Os.open(mDirectory.getAbsolutePath(),
+                OsConstants.O_RDONLY | OsConstants.O_CLOEXEC, 0);
+        try { Os.fsync(fd); } finally { Os.close(fd); }
+    }
+}
