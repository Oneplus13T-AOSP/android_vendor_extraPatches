diff --git a/graphics/java/android/graphics/FontModRuntime.java b/graphics/java/android/graphics/FontModRuntime.java
new file mode 100644
index 0000000..f750430
--- /dev/null
+++ b/graphics/java/android/graphics/FontModRuntime.java
@@ -0,0 +1,122 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.graphics;
+
+import android.annotation.NonNull;
+import android.app.Application;
+import android.content.Context;
+import android.graphics.fonts.Font;
+import android.graphics.fonts.FontFamily;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.ServiceManager;
+import android.util.Log;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowManagerGlobal;
+import android.widget.TextView;
+
+import com.android.internal.graphics.fonts.IFontManager;
+import com.android.internal.graphics.fonts.IFontModCallback;
+import com.android.internal.os.BackgroundThread;
+
+import org.json.JSONObject;
+import java.io.File;
+import java.util.ArrayDeque;
+
+/**
+ * Per-process live font refresh. Native web/map renderers remain independent.
+ *
+ * @hide
+ */
+public final class FontModRuntime {
+    private static final String TAG = "FontModRuntime";
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static boolean sInitialized;
+    private static long sGeneration = -1;
+    private static final IFontModCallback CALLBACK = new IFontModCallback.Stub() {
+        @Override public void onFontModChanged(String state) {
+            BackgroundThread.getHandler().post(() -> prepare(state, false));
+        }
+    };
+
+    private FontModRuntime() { }
+
+    public static void initialize(@NonNull Context context) {
+        if (sInitialized) return;
+        try {
+            IFontManager service = IFontManager.Stub.asInterface(
+                    ServiceManager.getService(Context.FONT_SERVICE));
+            if (service == null) return;
+            String state = service.registerFontModCallback(CALLBACK);
+            sInitialized = true;
+            // Initial selection is installed before Application.onCreate and content providers.
+            prepare(state, true);
+            if (context instanceof Application) {
+                ((Application) context).registerActivityLifecycleCallbacks(
+                        new Application.ActivityLifecycleCallbacks() {
+                    @Override public void onActivityResumed(android.app.Activity activity) {
+                        refreshViews(activity.getWindow().getDecorView());
+                    }
+                    @Override public void onActivityCreated(android.app.Activity a, android.os.Bundle b) { }
+                    @Override public void onActivityStarted(android.app.Activity a) { }
+                    @Override public void onActivityPaused(android.app.Activity a) { }
+                    @Override public void onActivityStopped(android.app.Activity a) { }
+                    @Override public void onActivitySaveInstanceState(android.app.Activity a, android.os.Bundle b) { }
+                    @Override public void onActivityDestroyed(android.app.Activity a) { }
+                });
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Cannot initialize live custom fonts; retaining current fonts", e);
+        }
+    }
+
+    private static void prepare(String state, boolean initial) {
+        try {
+            JSONObject value = new JSONObject(state);
+            if (value.getInt("version") != 1) throw new IllegalArgumentException("Unknown state");
+            String id = value.getString("id");
+            String path = value.getString("path");
+            long generation = value.getLong("generation");
+            FontFamily family = null;
+            if (!id.isEmpty()) {
+                if (!id.matches("[a-f0-9]{64}")
+                        || !path.equals("/data/fonts/fontmod/" + id + ".font")) {
+                    throw new IllegalArgumentException("Invalid custom font path");
+                }
+                family = new FontFamily.Builder(new Font.Builder(new File(path)).build()).build();
+            }
+            FontFamily prepared = family;
+            Runnable apply = () -> {
+                if (generation <= sGeneration) return;
+                try {
+                    Typeface.setFontModFont(prepared);
+                    sGeneration = generation;
+                    for (View view : WindowManagerGlobal.getInstance().getWindowViews()) {
+                        refreshViews(view);
+                    }
+                } catch (RuntimeException e) { Log.e(TAG, "Cannot refresh custom fonts", e); }
+            };
+            if (initial && Looper.myLooper() == Looper.getMainLooper()) apply.run();
+            else MAIN.post(apply);
+        } catch (Exception e) {
+            Log.e(TAG, "Cannot load selected custom font; retaining current fonts", e);
+        }
+    }
+
+    private static void refreshViews(View root) {
+        if (Typeface.getFontModGeneration() == 0) return;
+        ArrayDeque<View> pending = new ArrayDeque<>(); pending.add(root);
+        while (!pending.isEmpty()) {
+            View view = pending.removeFirst();
+            if (view instanceof TextView) ((TextView) view).refreshFontModTypeface();
+            if (view instanceof ViewGroup) {
+                ViewGroup group = (ViewGroup) view;
+                for (int i = 0; i < group.getChildCount(); i++) pending.add(group.getChildAt(i));
+            }
+            // Custom Canvas text (e.g. messaging UIs) refreshes Paint lazily on use.
+            view.requestLayout(); view.invalidate();
+        }
+    }
+}
