+/** Custom-only store. Never changes the signed font updater or its fs-verity policy. */
+final class FontModStore {
+    static final long MAX_BYTES = 32L * 1024 * 1024;
+    static final long MAX_RETAINED_BYTES = 512L * 1024 * 1024;
+    private static final String TAG = "FontModStore";
+    private final File mDirectory;
+    private final AtomicFile mConfig;
+    private final boolean mSafeMode;
+    private String mId = "";
+    private String mStoredId = "";
+    private long mGeneration;
+
+    FontModStore(File directory, File config, boolean safeMode) {
+        mDirectory = directory;
+        mConfig = new AtomicFile(config);
+        mSafeMode = safeMode;
+        // init.rc owns directory creation, permissions, and labeling on production devices.
+        load();
+    }
+
+    synchronized String state() {
+        try {
+            return new JSONObject().put("version", 1).put("id", mId)
+                    .put("storedId", mStoredId)
+                    .put("path", mId.isEmpty() ? "" : fileFor(mId).getAbsolutePath())
+                    .put("generation", mGeneration).put("safeMode", mSafeMode).toString();
+        } catch (org.json.JSONException e) { throw new IllegalStateException(e); }
+    }
+
+    synchronized String install(ParcelFileDescriptor descriptor, String expectedSha256, long expectedGeneration)
+            throws IOException {
+        if (mSafeMode) throw new IOException("Custom fonts are disabled in safe mode");
+        checkGeneration(expectedGeneration);
+        if (!validId(expectedSha256)) throw new IOException("Invalid SHA-256 identifier");
+        if (!mDirectory.isDirectory()) throw new IOException("FontMod directory is unavailable");
+        File temporary = new File(mDirectory, "import-" + UUID.randomUUID() + ".tmp");
+        try {
+            if (mDirectory.getUsableSpace() < MAX_BYTES + 16L * 1024 * 1024) {
+                throw new IOException("Insufficient storage for font installation");
+            }
+            // Own the Binder copy/dup, not the caller's descriptor or its Java wrapper.
+            try (FileInputStream in = new ParcelFileDescriptor.AutoCloseInputStream(
+                        ParcelFileDescriptor.dup(descriptor.getFileDescriptor()));
