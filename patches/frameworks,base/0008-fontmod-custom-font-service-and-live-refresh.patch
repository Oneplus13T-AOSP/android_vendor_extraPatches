+        mId = id;
+        mStoredId = id;
+        mGeneration = next;
+    }
+
+    private void load() {
+        try (FileInputStream in = mConfig.openRead()) {
+            byte[] data = in.readNBytes(4097);
+            if (data.length > 4096) throw new IOException("Configuration too large");
+            JSONObject config = new JSONObject(new String(data, StandardCharsets.UTF_8));
+            if (config.getInt("version") != 1) throw new IOException("Unknown configuration version");
