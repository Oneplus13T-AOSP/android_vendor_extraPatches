+        return state();
+    }
+
+    private void checkGeneration(long expected) throws IOException {
+        if (expected != mGeneration) throw new IOException("Font selection changed; refresh and retry");
+    }
+
+    private void commit(String id) throws IOException {
+        long next = Math.addExact(mGeneration, 1);
+        FileOutputStream out = mConfig.startWrite();
+        try {
+            JSONObject config = new JSONObject().put("version", 1).put("id", id)
