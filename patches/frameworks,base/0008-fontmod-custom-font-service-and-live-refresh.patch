+                byte[] buffer = new byte[65536]; long total = 0; int n;
+                while ((n = in.read(buffer)) != -1) {
+                    total += n;
+                    if (total > MAX_BYTES) throw new IOException("Font exceeds 32 MiB");
+                    out.write(buffer, 0, n);
+                }
+                out.getFD().sync();
+            }
