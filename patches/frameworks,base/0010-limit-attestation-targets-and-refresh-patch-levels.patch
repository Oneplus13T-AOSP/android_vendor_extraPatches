         String content;
         try {
             content = android.provider.Settings.Secure.getString(
@@ -284,13 +277,14 @@
     }

     public CustomPatchLevel getCustomPatchLevel() {
+        maybeRefreshPatchLevel();
         return mPatchConfig;
     }

     public CustomPatchLevel getCustomPatchLevelForPackage(String[] packages) {
         // Patch levels are global in this build; per-package overrides are not exposed
