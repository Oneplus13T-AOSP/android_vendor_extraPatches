+        synchronized (mPatchRefreshLock) {
+            now = SystemClock.elapsedRealtime();
+            if (mLastPatchRefreshMs < 0L
+                    || now - mLastPatchRefreshMs >= CONFIG_REFRESH_COOLDOWN_MS) {
+                mLastPatchRefreshMs = now;
+                refreshPatchLevelLocked();
+            }
+        }
+    }
+
