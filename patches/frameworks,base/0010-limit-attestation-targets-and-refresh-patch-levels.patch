-            "com.reveny.nativecheck?",
-            "com.zhenxi.hunter?",
-            "luna.safe.luna?",
-            "com.rem01gaming.disclosure?"
+            "com.google.android.gms"
     );

     // Attesting through an injected process cannot produce a STRONG verdict, so those
