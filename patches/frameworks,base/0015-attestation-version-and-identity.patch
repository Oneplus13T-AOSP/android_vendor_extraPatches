+    /**
+     * Fresh random positive serial for a generated leaf.
+     *
+     * <p>KeyMint issues a random serial per key. A fixed serial shared by every attested
+     * key on every device is trivially recognisable as a software certificate, so mirror
+     * the hardware behaviour. 63 bits keeps it inside the X.509 positive range.
+     */
+    /** @hide visible for the host checks, which assert serials are random and positive. */
+    public static BigInteger generateRandomSerial() {
+        SecureRandom random = new SecureRandom();
+        byte[] bytes = new byte[8];
+        random.nextBytes(bytes);
+        bytes[0] &= 0x7f;
+        BigInteger serial = new BigInteger(1, bytes);
+        return serial.signum() == 0 ? BigInteger.ONE : serial.setBit(62);
+    }
