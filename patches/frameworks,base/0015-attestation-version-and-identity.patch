diff --git a/core/java/android/security/trickystore/AttestationVersion.java b/core/java/android/security/trickystore/AttestationVersion.java
new file mode 100644
index 000000000000..7f285f9e7e7c
--- /dev/null
+++ b/core/java/android/security/trickystore/AttestationVersion.java
@@ -0,0 +1,57 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.security.trickystore;
+
+/**
+ * Maps an API level to the KeyMint / Keymaster attestation version that release shipped,
+ * and to the {@code osVersion} integer written into KeyDescription.
+ *
+ * <p>Free of Android dependencies so the mapping that decides what the ROM asserts can be
+ * exercised on the host. The values matter because verifiers cross-check the asserted
+ * version against the attested key: claiming a newer KeyMint than the hardware supports is
+ * itself a mismatch.
+ *
+ * @hide
+ */
+public final class AttestationVersion {
+    private AttestationVersion() {}
+
+    /**
+     * KeyMint attestation version for the given API level.
+     *
+     * <p>Follows Evolution X so both ROMs assert the same thing for the same hardware.
+     * API levels below 29 are not mapped explicitly: those devices cannot ship this ROM,
+     * and the trailing branch mirrors the reference behaviour.
+     */
+    public static int forApiLevel(int apiLevel) {
+        switch (apiLevel) {
+            case 29:
+            case 30:
+                return 4;
+            case 31:
+            case 32:
+                return 100;
+            case 33:
+                return 200;
+            case 34:
+            case 35:
+                return 300;
+            case 36:
+                return 400;
+            default:
+                return apiLevel >= 37 ? 500 : 400;
+        }
+    }
+
+    /** {@code keymasterVersion} as KeyMint reports it for a given attestation version. */
+    public static int keymasterVersion(int attestVersion) {
+        return attestVersion == 4 ? 41 : attestVersion;
+    }
+
+    /** KeyMint {@code osVersion} encoding, i.e. API 36 -> 160000. */
+    public static int osVersion(int apiLevel) {
+        return apiLevel * 10000;
+    }
+}
