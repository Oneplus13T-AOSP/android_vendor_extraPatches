+    /** AUTO may recover hardware failures; LEAF_HACK must keep the original key. */
+    public boolean needSoftwareFallback(int uid, String[] packages) {
+        if (packages == null) return false;
+        maybeRefreshTargets();
+        for (String pkg : packages) {
+            if (XPOSED_PACKAGES.contains(pkg)) continue;
+            Mode mode = mPackageModes.get(pkg);
+            if (mode == Mode.AUTO || mode == Mode.GENERATE) return true;
+        }
+        return false;
+    }
+
+    /** Resolve the local process, never the UID of a nested Binder caller. */
+    public static String[] resolveCallerPackages() {
+        if (android.os.Process.isIsolated()) return null;
+        try {
+            if (android.app.ActivityThread.getPackageManager() != null) {
+                String[] packages = android.app.ActivityThread.getPackageManager()
+                        .getPackagesForUid(android.os.Process.myUid());
+                if (packages != null && packages.length > 0) return packages;
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Package lookup failed; trying the bound application", e);
+        }
+        String bound = android.app.ActivityThread.currentPackageName();
+        if (bound != null && !bound.isEmpty()) {
+            Log.i(TAG, "Using bound application for key policy");
+            return new String[] {bound};
+        }
+        Log.w(TAG, "No caller package for uid=" + android.os.Process.myUid());
+        return null;
+    }
+
     private void maybeRefreshTargets() {
         long now = SystemClock.elapsedRealtime();
         if (now - mLastTargetsRefreshMs < TARGETS_REFRESH_COOLDOWN_MS) return;
