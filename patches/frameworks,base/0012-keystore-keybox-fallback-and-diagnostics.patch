+ */
+package android.security.trickystore;
+
+import android.hardware.security.keymint.Algorithm;
+import android.hardware.security.keymint.EcCurve;
+import android.hardware.security.keymint.ErrorCode;
+import android.hardware.security.keymint.KeyParameter;
+import android.hardware.security.keymint.KeyPurpose;
+import android.hardware.security.keymint.SecurityLevel;
+import android.hardware.security.keymint.Tag;
+import android.os.Process;
+import android.security.KeyStore2;
+import android.security.KeyStoreException;
+import android.security.KeyStoreSecurityLevel;
+import android.security.pif.PlayIntegrityProfile;
+import android.system.keystore2.Domain;
+import android.system.keystore2.KeyDescriptor;
+import android.system.keystore2.KeyEntryResponse;
+import android.system.keystore2.KeyMetadata;
+import android.util.Log;
+
+import java.io.ByteArrayOutputStream;
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.cert.Certificate;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+import javax.security.auth.x500.X500Principal;
+
+/**
+ * Recovery at the Java Keystore boundary, including callers that bypass the SPI.
+ * @hide
+ */
+public final class KeyboxGenerationFallback {
+    private static final String TAG = "KeyboxFallback";
+
+    private KeyboxGenerationFallback() {}
+
+    static boolean recoverable(int error) {
+        return error == ErrorCode.SECURE_HW_COMMUNICATION_FAILED
+                || error == ErrorCode.ATTESTATION_KEYS_NOT_PROVISIONED;
+    }
+
+    static boolean eligible(int level, KeyDescriptor descriptor, KeyDescriptor signer,
+            Collection<KeyParameter> args) {
+        if (level != SecurityLevel.TRUSTED_ENVIRONMENT || descriptor == null
+                || descriptor.domain != Domain.APP || descriptor.alias == null
+                || signer != null || "TrickyStoreTeeCheck".equals(descriptor.alias)
+                || "trickystore_attestation_key".equals(descriptor.alias)) return false;
+        boolean challenge = false;
+        int algorithm = -1;
+        for (KeyParameter p : args) {
+            switch (p.tag) {
+                case Tag.ALGORITHM: algorithm = p.value.getAlgorithm(); break;
+                case Tag.ATTESTATION_CHALLENGE:
+                    byte[] bytes = p.value.getBlob();
+                    challenge = bytes != null && bytes.length <= 128;
+                    break;
+                case Tag.EC_CURVE:
+                    if (p.value.getEcCurve() == EcCurve.CURVE_25519) return false;
+                    break;
+                case Tag.PURPOSE:
+                    if (p.value.getKeyPurpose() == KeyPurpose.ATTEST_KEY) return false;
+                    break;
+                case Tag.DEVICE_UNIQUE_ATTESTATION: return false;
+            }
+        }
+        return challenge && (algorithm == Algorithm.EC || algorithm == Algorithm.RSA);
+    }
+
+    /** Keep key authorizations, but do not ask importKey to perform attestation. */
+    static List<KeyParameter> importArguments(Collection<KeyParameter> args) {
+        List<KeyParameter> result = new ArrayList<>();
+        for (KeyParameter p : args) {
+            switch (p.tag) {
+                case Tag.ATTESTATION_CHALLENGE:
+                case Tag.ATTESTATION_APPLICATION_ID:
+                case Tag.ATTESTATION_ID_BRAND:
+                case Tag.ATTESTATION_ID_DEVICE:
+                case Tag.ATTESTATION_ID_PRODUCT:
+                case Tag.ATTESTATION_ID_SERIAL:
+                case Tag.ATTESTATION_ID_IMEI:
+                case Tag.ATTESTATION_ID_SECOND_IMEI:
+                case Tag.ATTESTATION_ID_MEID:
+                case Tag.ATTESTATION_ID_MANUFACTURER:
+                case Tag.ATTESTATION_ID_MODEL:
+                case Tag.DEVICE_UNIQUE_ATTESTATION:
+                case Tag.INCLUDE_UNIQUE_ID:
+                case Tag.RESET_SINCE_ID_ROTATION:
+                case Tag.CERTIFICATE_NOT_BEFORE:
+                case Tag.CERTIFICATE_NOT_AFTER:
+                case Tag.CERTIFICATE_SERIAL:
+                case Tag.CERTIFICATE_SUBJECT:
+                    break;
+                default: result.add(p);
+            }
+        }
+        return result;
+    }
+
+    static CertificateGenerator.KeyGenParameters parameters(Collection<KeyParameter> args) {
+        CertificateGenerator.KeyGenParameters result = new CertificateGenerator.KeyGenParameters();
+        for (KeyParameter p : args) {
+            switch (p.tag) {
+                case Tag.ALGORITHM: result.algorithm = p.value.getAlgorithm(); break;
+                case Tag.KEY_SIZE: result.keySize = p.value.getInteger(); break;
+                case Tag.EC_CURVE: result.ecCurve = p.value.getEcCurve(); break;
+                case Tag.RSA_PUBLIC_EXPONENT:
+                    result.rsaPublicExponent = new BigInteger(
+                            Long.toUnsignedString(p.value.getLongInteger()));
+                    break;
+                case Tag.PURPOSE: result.purpose.add(p.value.getKeyPurpose()); break;
+                case Tag.DIGEST: result.digest.add(p.value.getDigest()); break;
+                case Tag.PADDING: result.padding.add(p.value.getPaddingMode()); break;
+                case Tag.RSA_OAEP_MGF_DIGEST:
+                    result.rsaOaepMgfDigest.add(p.value.getDigest()); break;
+                case Tag.ATTESTATION_CHALLENGE:
+                    result.attestationChallenge = p.value.getBlob(); break;
+                case Tag.CERTIFICATE_SERIAL:
+                    result.certificateSerial = new BigInteger(1, p.value.getBlob()); break;
+                case Tag.CERTIFICATE_SUBJECT:
+                    result.certificateSubject = new X500Principal(p.value.getBlob()); break;
+                case Tag.CERTIFICATE_NOT_BEFORE:
+                    result.certificateNotBefore = new Date(p.value.getDateTime()); break;
+                case Tag.CERTIFICATE_NOT_AFTER:
+                    result.certificateNotAfter = new Date(p.value.getDateTime()); break;
+            }
+        }
+        if (result.algorithm == Algorithm.EC) {
+            switch (result.ecCurve) {
+                case EcCurve.P_224: result.ecCurveName = "secp224r1"; result.keySize = 224; break;
+                case EcCurve.P_256: result.ecCurveName = "secp256r1"; result.keySize = 256; break;
+                case EcCurve.P_384: result.ecCurveName = "secp384r1"; result.keySize = 384; break;
+                case EcCurve.P_521: result.ecCurveName = "secp521r1"; result.keySize = 521; break;
+                default: throw new IllegalArgumentException("Unsupported EC curve");
+            }
+        }
+        return result;
+    }
+
+    public static KeyMetadata tryGenerate(KeyStoreSecurityLevel backend, int level,
+            KeyDescriptor descriptor, KeyDescriptor signer, Collection<KeyParameter> args,
+            int flags, KeyStoreException failure) {
+        if (!recoverable(failure.getErrorCode())) return null;
+        byte[] encodedKey = null;
+        KeyDescriptor imported = null;
+        KeyStore2 store = KeyStore2.getInstance();
+        try {
+            boolean eligible = eligible(level, descriptor, signer, args);
+            Log.i(TAG, "Hardware failure: code=" + failure.getErrorCode()
+                    + " uid=" + Process.myUid() + " level=" + level + " eligible=" + eligible);
+            if (!eligible) return null;
+            String[] packages = TrickyStoreService.resolveCallerPackages();
+            TrickyStoreService service = TrickyStoreService.getInstance();
+            boolean target = service.needSoftwareFallback(Process.myUid(), packages);
+            boolean keybox = target && service.hasKeyboxes();
+            Log.i(TAG, "Policy: packages=" + (packages == null ? 0 : packages.length)
+                    + " target=" + target + " keybox=" + keybox);
+            if (!keybox) return null;
+
+            CertificateGenerator.KeyGenParameters params = parameters(args);
+            params.packages = packages;
+            Map<String, String> identity = PlayIntegrityProfile.isSpoofedPackage(packages)
+                    ? PlayIntegrityProfile.getIdentity() : null;
+            if (PlayIntegrityProfile.isSpoofedPackage(packages)) {
+                params.brand = PlayIntegrityProfile.identityBytes(identity, "BRAND");
+                params.device = PlayIntegrityProfile.identityBytes(identity, "DEVICE");
+                params.product = PlayIntegrityProfile.identityBytes(identity, "PRODUCT");
+                params.manufacturer = PlayIntegrityProfile.identityBytes(identity, "MANUFACTURER");
+                params.model = PlayIntegrityProfile.identityBytes(identity, "MODEL");
+            }
+            KeyPair pair = CertificateGenerator.generateKeyPair(params);
+            List<Certificate> chain = CertificateGenerator.generateCertificateChain(
+                    pair, params, Process.myUid());
+            if (chain == null || chain.isEmpty()) {
+                throw new IllegalStateException("No software certificate chain");
+            }
+            // Assemble everything before import; importKey returns the actual Keystore key ID.
+            byte[] leaf = chain.get(0).getEncoded();
+            ByteArrayOutputStream cas = new ByteArrayOutputStream();
+            for (int i = 1; i < chain.size(); i++) cas.write(chain.get(i).getEncoded());
+            encodedKey = pair.getPrivate().getEncoded();
+            if (encodedKey == null) throw new IllegalStateException("Private key is not exportable");
+            KeyMetadata metadata = backend.importKey(
+                    descriptor, null, importArguments(args), flags, encodedKey);
+            if (metadata == null || metadata.key == null) {
+                throw new IllegalStateException("Import returned no key descriptor");
+            }
+            imported = metadata.key;
+            store.updateSubcomponents(imported, leaf, cas.size() == 0 ? null : cas.toByteArray());
+            KeyEntryResponse entry = store.getKeyEntry(imported);
+            if (entry == null || entry.metadata == null) {
+                throw new IllegalStateException("Imported key metadata is missing");
+            }
+            Log.i(TAG, "Software fallback installed: uid=" + Process.myUid());
+            imported = null; // Ownership transfers to the caller only after metadata is available.
+            return entry.metadata;
+        } catch (Exception e) {
+            Log.w(TAG, "Software fallback failed; preserving original hardware error", e);
+            return null;
+        } finally {
+            if (encodedKey != null) Arrays.fill(encodedKey, (byte) 0);
+            if (imported != null) {
+                try {
+                    store.deleteKey(imported);
+                } catch (KeyStoreException cleanup) {
+                    Log.w(TAG, "Failed to remove incomplete imported key", cleanup);
+                }
+            }
+        }
+    }
+}
