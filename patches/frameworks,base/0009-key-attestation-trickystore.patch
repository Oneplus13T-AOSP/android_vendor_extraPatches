+package android.security.pif;
+
+import android.app.ActivityThread;
+import android.content.Context;
+import android.os.Build;
+import android.text.TextUtils;
+import android.util.Log;
+
+import com.android.internal.R;
+
+import org.json.JSONObject;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Read-only view of the Play Integrity profile Play Integrity Fix already applies to
+ * the GMS and Play Store process Build fields.
+ *
+ * <p>Keystore needs the same identity when it writes an attestation certificate:
+ * the TEE/Minte attestation request carries the handset's real ODM properties, while
+ * the requesting process Build carries the spoofed profile. Play Integrity
+ * cross-checks the certificate against the Build fields, so the attestation has to
+ * tell the same story as the spoof.
+ *
+ * <p>The values are only consulted for callers the PIF hook itself spoofs (GMS
+ * unstable process and Play Store), and only when the caller has an attestation
+ * challenge, so ordinary application key generation keeps its real identity.
+ *
+ * @hide
+ */
+public final class PlayIntegrityProfile {
+    private static final String TAG = "PifProfile";
+
+    public static final String PACKAGE_GMS = "com.google.android.gms";
+    public static final String PACKAGE_FINSKY = "com.android.vending";
+
+    private static final String[] IDENTITY_FIELDS = {
+            "BRAND", "DEVICE", "PRODUCT", "MANUFACTURER", "MODEL"
+    };
+
+    // Reading Settings.Secure on every Keystore call would be wasteful: GMS generates a
+    // handful of attestation keys and the profile changes only when the user loads a new
+    // one. A short window keeps a replaced profile from being served for long.
+    private static final long CACHE_TTL_MS = 30_000L;
+
+    private static volatile Map<String, String> sCachedFields;
+    private static volatile long sCachedAtMs;
+
+    private PlayIntegrityProfile() {}
+
+    /**
+     * Whether the given package list contains a process whose Build fields the PIF
+     * hook replaces, and for which an attestation must therefore carry the profile.
+     */
+    public static boolean isSpoofedPackage(String[] packages) {
+        if (packages == null) return false;
+        // The framework applies the PIF profile to the GMS unstable (DroidGuard)
+        // process and to Play Store, but package lists carry the base package name.
+        for (String pkg : packages) {
+            if (PACKAGE_GMS.equals(pkg) || PACKAGE_FINSKY.equals(pkg)) return true;
+        }
+        return false;
+    }
+
+    /**
+     * The five attested identity values, in BRAND/DEVICE/PRODUCT/MANUFACTURER/MODEL
+     * order, or null when no profile applies to the caller right now.
+     *
+     * <p>Returns null in an isolated process. PIF deliberately skips Build spoofing
+     * there because an isolated process cannot reach Settings, so its Build fields are
+     * the handset's own; signing the profile identity into the certificate would
+     * create exactly the contradiction this class exists to avoid. The same guard in
+     * {@link #isProfileLive} covers a non-isolated process the hook failed to spoof.
+     */
+    public static Map<String, String> getIdentity() {
+        if (android.os.Process.isIsolated()) return null;
+
+        Map<String, String> fields = loadFields();
+        if (!isProfileLive(fields)) return null;
+
+        Map<String, String> identity = new HashMap<>();
+        for (String field : IDENTITY_FIELDS) {
+            String value = fields.get(field);
+            if (!TextUtils.isEmpty(value)) identity.put(field, value);
+        }
+        return identity.isEmpty() ? null : Collections.unmodifiableMap(identity);
+    }
+
+    /**
+     * Whether the process Build already carries this profile. Without this check the
+     * certificate could claim a Pixel identity while the Build reports the handset's
+     * own, which is the mismatch that fails device integrity.
+     */
+    private static boolean isProfileLive(Map<String, String> fields) {
+        String profileFp = fields.get("FINGERPRINT");
+        if (TextUtils.isEmpty(profileFp)) {
+            // A profile without a fingerprint cannot be confirmed; require at least a
+            // spoofed BRAND so a half-applied profile is not signed.
+            return !TextUtils.isEmpty(fields.get("BRAND"));
+        }
+        return profileFp.equals(Build.FINGERPRINT);
+    }
+
+    /**
+     * Same source precedence the PIF hook uses: user supplied PIF JSON, then the copy
+     * fetched by AttestationService, then the product's certified build properties.
+     *
+     * <p>Cached briefly: this runs on every Keystore certificate request, and reading
+     * Settings.Secure each time would add a Binder round trip to key generation. The
+     * window is short enough that a replaced profile is still picked up quickly.
+     */
+    private static Map<String, String> loadFields() {
+        Map<String, String> cached = sCachedFields;
+        long age = System.currentTimeMillis() - sCachedAtMs;
+        if (cached != null && age >= 0 && age < CACHE_TTL_MS) return cached;
+
+        Map<String, String> fields = new HashMap<>();
+        Context context = currentContext();
+        if (context == null) return fields;
+
+        try {
+            JSONObject json = readProfileJson(context);
+            if (json != null) {
+                Iterator<String> keys = json.keys();
+                while (keys.hasNext()) {
+                    String key = keys.next();
+                    fields.put(key.toUpperCase(Locale.US), json.optString(key, ""));
+                }
+            } else {
+                for (String entry : context.getResources()
+                        .getStringArray(R.array.config_certifiedBuildProperties)) {
+                    int colon = entry.indexOf(':');
+                    if (colon <= 0) continue;
+                    fields.put(entry.substring(0, colon).trim().toUpperCase(Locale.US),
+                            entry.substring(colon + 1).trim());
+                }
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to read the Play Integrity profile", e);
+        }
+
+        // PIF's own migration derives the parts of the identity the JSON omits from
+        // FINGERPRINT, so a profile carrying only the fingerprint still gets a
+        // consistent BRAND/PRODUCT/DEVICE. Do the same here instead of attesting a
+        // half-spoofed identity.
+        deriveFromFingerprint(fields);
+        sCachedFields = fields;
+        sCachedAtMs = System.currentTimeMillis();
+        return fields;
+    }
+
+    private static JSONObject readProfileJson(Context context) {
+        try {
+            android.content.ContentResolver resolver = context.getContentResolver();
+            String saved = android.provider.Settings.Secure.getString(
+                    resolver, android.provider.Settings.Secure.PIF_DATA);
+            if (TextUtils.isEmpty(saved)) {
+                saved = android.provider.Settings.Secure.getString(
+                        resolver, android.provider.Settings.Secure.FETCHED_PIF);
+            }
+            if (TextUtils.isEmpty(saved)) return null;
+            return new JSONObject(saved);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** Fills BRAND/PRODUCT/DEVICE from FINGERPRINT when the profile omits them. */
+    private static void deriveFromFingerprint(Map<String, String> fields) {
+        String fp = fields.get("FINGERPRINT");
+        if (TextUtils.isEmpty(fp)) return;
+        int colon = fp.indexOf(':');
+        if (colon < 0) return;
+        String[] head = fp.substring(0, colon).split("/");
+        if (head.length == 3) {
+            putIfAbsent(fields, "BRAND", head[0]);
+            putIfAbsent(fields, "PRODUCT", head[1]);
+            putIfAbsent(fields, "DEVICE", head[2]);
+        }
+    }
+
+    private static void putIfAbsent(Map<String, String> fields, String key, String value) {
+        if (TextUtils.isEmpty(fields.get(key)) && !TextUtils.isEmpty(value)) {
+            fields.put(key, value);
+        }
+    }
+
+    private static Context currentContext() {
+        try {
+            if (ActivityThread.currentActivityThread() == null) return null;
+            Context app = ActivityThread.currentApplication();
+            if (app != null) return app;
+            return ActivityThread.currentActivityThread().getSystemContext();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /**
+     * Identity bytes for the attestation certificate, falling back to the process
+     * Build fields (which the PIF hook has already replaced for a spoofed caller)
+     * when no explicit profile is available.
+     */
+    public static byte[] identityBytes(Map<String, String> identity, String field) {
+        String value = identity != null ? identity.get(field) : null;
+        if (TextUtils.isEmpty(value)) value = buildField(field);
+        return TextUtils.isEmpty(value) ? null : value.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    }
+
+    private static String buildField(String field) {
+        switch (field) {
+            case "BRAND": return Build.BRAND;
+            case "DEVICE": return Build.DEVICE;
+            case "PRODUCT": return Build.PRODUCT;
+            case "MANUFACTURER": return Build.MANUFACTURER;
+            case "MODEL": return Build.MODEL;
+            default: return null;
+        }
+    }
+}
