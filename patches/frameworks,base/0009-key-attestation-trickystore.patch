+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security.trickystore;
+
+import android.os.SystemClock;
+import android.util.Log;
+
+import java.security.MessageDigest;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Holds the user supplied keybox and per-package attestation policy.
+ *
+ * <p>Both values live in Settings.Secure, which is the same transport PixelOS already
+ * uses for the Play Integrity profile: the development settings screen writes them, the
+ * framework reads them, and no extra privileged app or provider is involved.
+ *
+ * @hide
+ */
+public class TrickyStoreService {
+    private static final String TAG = "TrickyStoreService";
+
+    private static TrickyStoreService sInstance;
+
+    /** @hide */
+    public enum Mode {
+        /** Re-sign hardware attestations, or generate one when the TEE cannot attest. */
+        AUTO,
+        /** Re-sign the hardware attestation leaf; never replace the hardware key. */
+        LEAF_HACK,
+        /** Always build a software attestation chain, even if the TEE works. */
+        GENERATE,
+        /** Leave the caller completely untouched. */
+        SKIP
+    }
+
+    /**
+     * Packages whose attestations are rewritten by default. This mirrors the upstream
+     * TrickyStore target list closely enough that Play Integrity works out of the box,
+     * while leaving every unrelated application with its genuine hardware attestation.
+     */
+    public static final String DEFAULT_TARGET_LIST = String.join("\n",
+            "android",
+            "com.android.vending",
+            "com.google.android.gsf",
+            "com.google.android.gms",
+            "com.google.android.contactkeys",
+            "com.google.android.ims",
+            "com.google.android.safetycore",
+            "com.google.android.apps.walletnfcrel",
+            "com.google.android.apps.nbu.paisa.user",
+            "com.revolut.revolut!",
+            "io.github.qwq233.keyattestation?",
+            "io.github.vvb2060.keyattestation?",
+            "io.github.vvb2060.mahoshojo?",
+            "com.reveny.nativecheck?",
+            "com.zhenxi.hunter?",
+            "luna.safe.luna?",
+            "com.rem01gaming.disclosure?"
+    );
+
+    // Attesting through an injected process cannot produce a STRONG verdict, so those
+    // packages are never rewritten even if a target list names them.
+    public static final java.util.Set<String> XPOSED_PACKAGES = java.util.Set.of(
+            "org.lsposed.manager",
+            "io.github.lsposed.manager",
+            "de.robv.android.xposed.installer",
+            "org.meowcat.edxposed.manager",
+            "com.solohsu.android.edxp.manager",
+            "io.va.exposed",
+            "com.topjohnwu.lsplant.manager",
+            "me.weishu.exposed"
+    );
+
+    private static final long TARGETS_REFRESH_COOLDOWN_MS = 5_000L;
+    private static final long CONFIG_REFRESH_COOLDOWN_MS = 5_000L;
+
+    private volatile Map<String, Mode> mPackageModes = Collections.emptyMap();
+    private volatile long mLastTargetsRefreshMs = 0L;
+    private volatile long mLastKeyboxRefreshMs = 0L;
+    private volatile String mLastKeyboxFingerprint = null;
+    private volatile CustomPatchLevel mPatchConfig = null;
+
+    private final KeyBoxManager mKeyBoxManager;
+    private final Object mKeyboxRefreshLock = new Object();
+    private final Object mTargetsRefreshLock = new Object();
+
+    /** @hide */
+    public static class CustomPatchLevel {
+        public final String system;
+        public final String vendor;
+        public final String boot;
+
+        public CustomPatchLevel(String system, String vendor, String boot) {
+            this.system = system;
+            this.vendor = vendor;
+            this.boot = boot;
+        }
+    }
+
+    private TrickyStoreService() {
+        mKeyBoxManager = new KeyBoxManager();
+    }
+
+    public static synchronized TrickyStoreService getInstance() {
+        if (sInstance == null) {
+            sInstance = new TrickyStoreService();
+            sInstance.initialize();
+        }
+        return sInstance;
+    }
+
+    public void initialize() {
+        try {
+            refreshTargets();
+            refreshKeyBox();
+            refreshPatchLevel();
+            Log.i(TAG, "TrickyStoreService initialized");
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to initialize TrickyStore", e);
+        }
+    }
+
+    // ---------------------------------------------------------------- targets
+
+    private void refreshTargets() {
+        String content;
+        try {
+            content = android.provider.Settings.Secure.getString(
+                    resolver(),
+                    android.provider.Settings.Secure.TRICKY_STORE_TARGET);
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read the target list; keeping the current one", e);
+            return;
+        }
+        // A null value means the user never configured a list. Treat it like the
+        // built-in default, which is what makes Play Integrity work out of the box.
+        Map<String, Mode> parsed = parseTargets(
+                content == null || content.trim().isEmpty() ? DEFAULT_TARGET_LIST : content);
+        mPackageModes = Collections.unmodifiableMap(parsed);
+        Log.i(TAG, "Updated target policies: " + parsed.size());
+    }
+
+    private Map<String, Mode> parseTargets(String content) {
+        Map<String, Mode> parsed = new HashMap<>();
+        for (String raw : content.split("\n")) {
+            String line = raw.trim();
+            if (line.isEmpty() || line.startsWith("#")) continue;
+            if (line.endsWith("!")) {
+                String pkg = line.substring(0, line.length() - 1).trim();
+                if (!pkg.isEmpty()) parsed.put(pkg, Mode.GENERATE);
+            } else if (line.endsWith("?")) {
+                String pkg = line.substring(0, line.length() - 1).trim();
+                if (!pkg.isEmpty()) parsed.put(pkg, Mode.LEAF_HACK);
+            } else if (line.endsWith("-")) {
+                String pkg = line.substring(0, line.length() - 1).trim();
+                if (!pkg.isEmpty()) parsed.put(pkg, Mode.SKIP);
+            } else {
+                parsed.put(line, Mode.AUTO);
+            }
+        }
+        return parsed;
+    }
+
+    // ---------------------------------------------------------------- keybox
+
+    public void refreshKeyBox() {
+        synchronized (mKeyboxRefreshLock) {
+            mLastKeyboxRefreshMs = SystemClock.elapsedRealtime();
+            refreshKeyBoxLocked();
+        }
+    }
+
+    private void refreshKeyBoxLocked() {
+        String raw;
+        try {
+            raw = android.provider.Settings.Secure.getString(
+                    resolver(),
+                    android.provider.Settings.Secure.KEYBOX_DATA);
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read the keybox; keeping the current one", e);
+            return;
+        }
+        if (raw == null || raw.trim().isEmpty()) {
+            // An explicitly empty value means the keybox was deleted.
+            if (mKeyBoxManager.hasKeyboxes()) {
+                mKeyBoxManager.clear();
+            }
+            mLastKeyboxFingerprint = null;
+            return;
+        }
+        String fingerprint = sha256(raw);
+        if (fingerprint.equals(mLastKeyboxFingerprint)) {
+            return;
+        }
+        if (!mKeyBoxManager.parseKeybox(raw)) {
+            // Rejected as incomplete: the previous keyboxes stay loaded. Don't record
+            // this payload as applied, so the next read looks at it again.
+            mLastKeyboxFingerprint = null;
+            return;
+        }
+        if (mKeyBoxManager.hasKeyboxes()) {
+            mLastKeyboxFingerprint = fingerprint;
+            Log.i(TAG, "Keybox updated successfully");
+        } else {
+            mLastKeyboxFingerprint = null;
+            Log.e(TAG, "Keybox parse produced no usable entries");
+        }
+    }
+
+    private static String sha256(String text) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256")
+                    .digest(text.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            return AttestationUtils.bytesToHex(digest);
+        } catch (Exception e) {
+            throw new IllegalStateException("SHA-256 unavailable", e);
+        }
+    }
+
+    // ---------------------------------------------------------------- patch levels
+
+    public void refreshPatchLevel() {
+        String content;
+        try {
+            content = android.provider.Settings.Secure.getString(
+                    resolver(),
+                    android.provider.Settings.Secure.TRICKY_STORE_PATCH);
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read patch levels; keeping the current ones", e);
+            return;
+        }
+        if (content == null || content.trim().isEmpty()) {
+            mPatchConfig = null;
+            return;
+        }
+        try {
+            mPatchConfig = parsePatchText(content.trim());
+        } catch (Exception e) {
+            Log.e(TAG, "Invalid patch levels; retaining previous configuration", e);
+        }
+    }
+
+    private CustomPatchLevel parsePatchText(String content) {
+        String system = null, vendor = null, boot = null, all = null;
+        for (String raw : content.split("\n")) {
+            String line = raw.trim();
+            if (line.isEmpty() || line.startsWith("#")) continue;
+            int idx = line.indexOf('=');
+            if (idx > 0) {
+                String key = line.substring(0, idx).trim().toLowerCase(java.util.Locale.US);
+                String value = line.substring(idx + 1).trim();
+                switch (key) {
+                    case "system": system = value; break;
+                    case "vendor": vendor = value; break;
+                    case "boot":   boot   = value; break;
+                    case "all":    all    = value; break;
+                }
+            } else {
+                all = line;
+            }
+        }
+        if (system == null && vendor == null && boot == null && all == null) return null;
+        return new CustomPatchLevel(
+                system != null ? system : all,
+                vendor != null ? vendor : all,
+                boot   != null ? boot   : all);
+    }
+
+    public CustomPatchLevel getCustomPatchLevel() {
+        return mPatchConfig;
+    }
+
+    public CustomPatchLevel getCustomPatchLevelForPackage(String[] packages) {
+        // Patch levels are global in this build; per-package overrides are not exposed
+        // in the Settings screen yet.
+        return mPatchConfig;
+    }
+
+    // ---------------------------------------------------------------- policy
+
+    public boolean hasKeyboxes() {
+        maybeRefreshKeyBox();
+        return mKeyBoxManager.hasKeyboxes();
+    }
+
+    public KeyBoxManager getKeyBoxManager() {
+        maybeRefreshKeyBox();
+        return mKeyBoxManager;
+    }
+
+    /**
+     * Whether the attested certificate should be rewritten for this caller.
+     *
+     * <p>AUTO and LEAF_HACK both mean "keep the hardware key and re-sign its
+     * certificate". Nothing probes the TEE here: the hardware attempt happens in
+     * AndroidKeyStoreKeyPairGeneratorSpi and falls back to software generation if it
+     * produces no usable attestation, which is both cheaper and avoids nesting a key
+     * generation inside another one.
+     */
+    public boolean needHack(int callingUid, String[] packages) {
+        if (packages == null) return false;
+        maybeRefreshTargets();
+        for (String pkg : packages) {
+            if (XPOSED_PACKAGES.contains(pkg)) continue;
+            Mode mode = mPackageModes.get(pkg);
+            if (mode == Mode.AUTO || mode == Mode.LEAF_HACK) return true;
+        }
+        return false;
+    }
+
+    /**
+     * Whether the certificate must be generated from scratch, skipping the hardware
+     * key entirely. Only an explicit GENERATE target asks for that.
+     */
+    public boolean needGenerate(int callingUid, String[] packages) {
+        if (packages == null) return false;
+        maybeRefreshTargets();
+        for (String pkg : packages) {
+            if (XPOSED_PACKAGES.contains(pkg)) continue;
+            if (mPackageModes.get(pkg) == Mode.GENERATE) return true;
+        }
+        return false;
+    }
+
+    private void maybeRefreshTargets() {
+        long now = System.currentTimeMillis();
+        if (now - mLastTargetsRefreshMs < TARGETS_REFRESH_COOLDOWN_MS) return;
+        synchronized (mTargetsRefreshLock) {
+            now = System.currentTimeMillis();
+            if (now - mLastTargetsRefreshMs < TARGETS_REFRESH_COOLDOWN_MS) return;
+            mLastTargetsRefreshMs = now;
+            refreshTargets();
+        }
+    }
+
+    private void maybeRefreshKeyBox() {
+        long now = SystemClock.elapsedRealtime();
+        if (mLastKeyboxRefreshMs != 0L
+                && now - mLastKeyboxRefreshMs < CONFIG_REFRESH_COOLDOWN_MS) {
+            return;
+        }
+        synchronized (mKeyboxRefreshLock) {
+            now = SystemClock.elapsedRealtime();
+            if (mLastKeyboxRefreshMs == 0L
+                    || now - mLastKeyboxRefreshMs >= CONFIG_REFRESH_COOLDOWN_MS) {
+                mLastKeyboxRefreshMs = now;
+                refreshKeyBoxLocked();
+            }
+        }
+    }
+
+    private static android.content.Context systemContext() {
+        try {
+            if (android.app.ActivityThread.currentActivityThread() != null) {
+                android.content.Context app = android.app.ActivityThread.currentApplication();
+                if (app != null) return app;
+                android.content.Context system =
+                        android.app.ActivityThread.currentActivityThread().getSystemContext();
+                if (system != null) return system;
+            }
+            // system_server has no ActivityThread but does have an initial application.
+            return android.app.AppGlobals.getInitialApplication();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static android.content.ContentResolver resolver() {
+        android.content.Context context = systemContext();
+        if (context == null) throw new IllegalStateException("No context available");
+        return context.getContentResolver();
+    }
+}
