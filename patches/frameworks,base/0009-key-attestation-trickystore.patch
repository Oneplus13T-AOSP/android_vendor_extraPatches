+package android.security.trickystore;
+
+import com.android.internal.org.bouncycastle.asn1.ASN1Boolean;
+import com.android.internal.org.bouncycastle.asn1.ASN1Encodable;
+import com.android.internal.org.bouncycastle.asn1.ASN1EncodableVector;
+import com.android.internal.org.bouncycastle.asn1.ASN1Enumerated;
+import com.android.internal.org.bouncycastle.asn1.ASN1Integer;
+import com.android.internal.org.bouncycastle.asn1.ASN1ObjectIdentifier;
+import com.android.internal.org.bouncycastle.asn1.ASN1OctetString;
+import com.android.internal.org.bouncycastle.asn1.ASN1Sequence;
+import com.android.internal.org.bouncycastle.asn1.ASN1TaggedObject;
+import com.android.internal.org.bouncycastle.asn1.DERNull;
+import com.android.internal.org.bouncycastle.asn1.DEROctetString;
+import com.android.internal.org.bouncycastle.asn1.DERSequence;
+import com.android.internal.org.bouncycastle.asn1.DERSet;
+import com.android.internal.org.bouncycastle.asn1.DERTaggedObject;
+import com.android.internal.org.bouncycastle.asn1.x509.Extension;
+
+import java.math.BigInteger;
+import java.security.spec.RSAKeyGenParameterSpec;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Encodes the KeyMint attestation extension ({@code 1.3.6.1.4.1.11129.2.1.17}) for a
+ * generated leaf certificate.
+ *
+ * <p>Deliberately free of Android framework dependencies so the exact bytes the device
+ * will sign can be produced and inspected on the host.
+ *
+ * @hide
+ */
+public final class AttestationExtensionBuilder {
+    public static final ASN1ObjectIdentifier ATTESTATION_OID =
+            new ASN1ObjectIdentifier("1.3.6.1.4.1.11129.2.1.17");
+
+    // Hardware identity tags. GMS asks for attestation with the handset's own ODM
+    // properties, so these must be written from the spoofed profile instead.
+    public static final int TAG_ATTESTATION_ID_BRAND = 710;
+    public static final int TAG_ATTESTATION_ID_DEVICE = 711;
+    public static final int TAG_ATTESTATION_ID_PRODUCT = 712;
+    public static final int TAG_ATTESTATION_ID_MANUFACTURER = 716;
+    public static final int TAG_ATTESTATION_ID_MODEL = 717;
+
+    private AttestationExtensionBuilder() {}
+
+    /** @hide */
+    public static final class Params {
+        public int algorithm;
+        public int keySize;
+        public int ecCurve;
+        public BigInteger rsaPublicExponent;
+        public List<Integer> purpose = new ArrayList<>();
+        public List<Integer> digest = new ArrayList<>();
+        public List<Integer> padding = new ArrayList<>();
+        public List<Integer> rsaOaepMgfDigest = new ArrayList<>();
+        public byte[] challenge;
+        public byte[] bootKey;
+        public byte[] bootHash;
+        /** {system (YYYYMM), vendor (YYYYMMDD), boot (YYYYMMDD)} */
+        public int[] patchLevels = new int[] {202404, 20240405, 20240405};
+        public int osVersion;
+        public int attestVersion;
+        public int keymasterVersion;
+        public long creationTimeMillis = System.currentTimeMillis();
+        public byte[] brand;
+        public byte[] device;
+        public byte[] product;
+        public byte[] manufacturer;
+        public byte[] model;
+        /** Already DER-encoded AttestationApplicationId, or null. */
+        public byte[] applicationId;
+    }
+
+    public static Extension build(Params params) {
+        byte[] challenge = params.challenge != null ? params.challenge : new byte[0];
+        byte[] bootKey = params.bootKey != null ? params.bootKey : new byte[32];
+        byte[] bootHash = params.bootHash != null ? params.bootHash : new byte[32];
+
+        ASN1Encodable[] rootOfTrustElements = new ASN1Encodable[] {
+                new DEROctetString(bootKey),
+                ASN1Boolean.TRUE,
+                new ASN1Enumerated(0),
+                new DEROctetString(bootHash)
+        };
+        DERSequence rootOfTrust = new DERSequence(rootOfTrustElements);
+
+        // AuthorizationList entries must be emitted in ascending tag order, exactly as
+        // KeyMint does, so collect them in a TreeMap first.
+        TreeMap<Integer, ASN1Encodable> tee = new TreeMap<>();
+        if (!params.purpose.isEmpty()) {
+            tee.put(1, toIntegerSet(params.purpose));
+        }
+        tee.put(2, new ASN1Integer(params.algorithm));
+        tee.put(3, new ASN1Integer(params.keySize));
+        if (!params.digest.isEmpty()) {
+            tee.put(5, toIntegerSet(params.digest));
+        }
+        if (!params.padding.isEmpty()) {
+            tee.put(6, toIntegerSet(params.padding));
+        }
+        if (params.algorithm == 3) {
+            // EC_CURVE is only reported for EC keys.
+            tee.put(10, new ASN1Integer(params.ecCurve));
+        } else if (params.algorithm == 1) {
+            tee.put(200, new ASN1Integer(params.rsaPublicExponent != null
+                    ? params.rsaPublicExponent : RSAKeyGenParameterSpec.F4));
+            // Tag 203 = RSA_OAEP_MGF_DIGEST (KeyMint 3+)
+            if (!params.rsaOaepMgfDigest.isEmpty()) {
+                tee.put(203, toIntegerSet(params.rsaOaepMgfDigest));
+            }
+        }
+        tee.put(503, DERNull.INSTANCE);
+        tee.put(702, new ASN1Integer(0));
+        tee.put(704, rootOfTrust);
+        tee.put(705, new ASN1Integer(params.osVersion));
+        tee.put(706, new ASN1Integer(params.patchLevels[0]));
+        if (params.brand != null) {
+            tee.put(TAG_ATTESTATION_ID_BRAND, new DEROctetString(params.brand));
+        }
+        if (params.device != null) {
+            tee.put(TAG_ATTESTATION_ID_DEVICE, new DEROctetString(params.device));
+        }
+        if (params.product != null) {
+            tee.put(TAG_ATTESTATION_ID_PRODUCT, new DEROctetString(params.product));
+        }
+        if (params.manufacturer != null) {
+            tee.put(TAG_ATTESTATION_ID_MANUFACTURER, new DEROctetString(params.manufacturer));
+        }
+        if (params.model != null) {
+            tee.put(TAG_ATTESTATION_ID_MODEL, new DEROctetString(params.model));
+        }
+        tee.put(718, new ASN1Integer(params.patchLevels[1]));
+        tee.put(719, new ASN1Integer(params.patchLevels[2]));
+
+        TreeMap<Integer, ASN1Encodable> sw = new TreeMap<>();
+        sw.put(701, new ASN1Integer(params.creationTimeMillis));
+        if (params.applicationId != null) {
+            sw.put(709, new DEROctetString(params.applicationId));
+        }
+
+        ASN1Encodable[] keyDescriptionElements = new ASN1Encodable[] {
+                new ASN1Integer(params.attestVersion),
+                new ASN1Enumerated(1 /* TEE */),
+                new ASN1Integer(params.keymasterVersion),
+                new ASN1Enumerated(1 /* TEE */),
+                new DEROctetString(challenge),
+                new DEROctetString(new byte[0]),
+                toAuthorizationList(sw),
+                toAuthorizationList(tee)
+        };
+
+        DERSequence keyDescription = new DERSequence(keyDescriptionElements);
+        DEROctetString octets;
+        try {
+            octets = new DEROctetString(keyDescription.getEncoded());
+        } catch (java.io.IOException e) {
+            throw new IllegalStateException("Failed to encode KeyDescription", e);
+        }
+        return new Extension(ATTESTATION_OID, false, octets);
+    }
+
+    private static DERSet toIntegerSet(List<Integer> values) {
+        ASN1Integer[] arr = new ASN1Integer[values.size()];
+        for (int i = 0; i < arr.length; i++) {
+            arr[i] = new ASN1Integer(values.get(i));
+        }
+        return new DERSet(arr);
+    }
+
+    static DERSequence toAuthorizationList(TreeMap<Integer, ASN1Encodable> fields) {
+        ASN1EncodableVector vector = new ASN1EncodableVector();
+        for (Map.Entry<Integer, ASN1Encodable> e : fields.entrySet()) {
+            vector.add(new DERTaggedObject(true, e.getKey(), e.getValue()));
+        }
+        return new DERSequence(vector);
+    }
+
+    // ------------------------------------------------------------ test helpers
+
+    /** Decodes an extension value into its KeyDescription SEQUENCE. */
+    public static ASN1Sequence decodeKeyDescription(Extension extension) {
+        try {
+            return ASN1Sequence.getInstance(
+                    ASN1OctetString.getInstance(extension.getExtnValue()).getOctets());
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** Tag numbers of the teeEnforced (index 7) or softwareEnforced (index 6) list. */
+    public static List<Integer> tagNumbers(ASN1Sequence keyDescription, int index) {
+        List<Integer> tags = new ArrayList<>();
+        ASN1Sequence seq = ASN1Sequence.getInstance(keyDescription.getObjectAt(index));
+        for (int i = 0; i < seq.size(); i++) {
+            tags.add(ASN1TaggedObject.getInstance(seq.getObjectAt(i)).getTagNo());
+        }
+        return tags;
+    }
+
+    /** One tagged octet string out of an AuthorizationList, or null. */
+    public static byte[] octets(ASN1Sequence keyDescription, int index, int tag) {
+        ASN1Sequence seq = ASN1Sequence.getInstance(keyDescription.getObjectAt(index));
+        for (int i = 0; i < seq.size(); i++) {
+            ASN1TaggedObject tagged = ASN1TaggedObject.getInstance(seq.getObjectAt(i));
+            if (tagged.getTagNo() != tag) continue;
+            try {
+                return ASN1OctetString.getInstance(tagged.getBaseObject()).getOctets();
+            } catch (Exception e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    /** One tagged integer out of an AuthorizationList, or null. */
+    public static BigInteger integer(ASN1Sequence keyDescription, int index, int tag) {
+        ASN1Sequence seq = ASN1Sequence.getInstance(keyDescription.getObjectAt(index));
+        for (int i = 0; i < seq.size(); i++) {
+            ASN1TaggedObject tagged = ASN1TaggedObject.getInstance(seq.getObjectAt(i));
+            if (tagged.getTagNo() != tag) continue;
+            try {
+                return ASN1Integer.getInstance(tagged.getBaseObject()).getValue();
+            } catch (Exception e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    /** RootOfTrust (704) as {bootKey, bootHash}. */
+    public static byte[][] rootOfTrust(ASN1Sequence keyDescription) {
+        ASN1Sequence seq = ASN1Sequence.getInstance(keyDescription.getObjectAt(7));
+        for (int i = 0; i < seq.size(); i++) {
+            ASN1TaggedObject tagged = ASN1TaggedObject.getInstance(seq.getObjectAt(i));
+            if (tagged.getTagNo() != 704) continue;
+            ASN1Sequence rot = ASN1Sequence.getInstance(tagged.getBaseObject());
+            if (rot.size() < 4) return null;
+            try {
+                return new byte[][] {
+                        ASN1OctetString.getInstance(rot.getObjectAt(0)).getOctets(),
+                        ASN1OctetString.getInstance(rot.getObjectAt(3)).getOctets()
+                };
+            } catch (Exception e) {
+                return null;
+            }
+        }
+        return null;
+    }
+}
