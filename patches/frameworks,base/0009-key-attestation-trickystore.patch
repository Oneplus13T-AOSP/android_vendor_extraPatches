+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security.trickystore;
+
+import com.android.internal.org.bouncycastle.asn1.ASN1Boolean;
+import com.android.internal.org.bouncycastle.asn1.ASN1Encodable;
+import com.android.internal.org.bouncycastle.asn1.ASN1EncodableVector;
+import com.android.internal.org.bouncycastle.asn1.ASN1Enumerated;
+import com.android.internal.org.bouncycastle.asn1.ASN1Integer;
+import com.android.internal.org.bouncycastle.asn1.ASN1ObjectIdentifier;
+import com.android.internal.org.bouncycastle.asn1.ASN1OctetString;
+import com.android.internal.org.bouncycastle.asn1.ASN1Sequence;
+import com.android.internal.org.bouncycastle.asn1.ASN1TaggedObject;
+import com.android.internal.org.bouncycastle.asn1.DEROctetString;
+import com.android.internal.org.bouncycastle.asn1.DERSequence;
+import com.android.internal.org.bouncycastle.asn1.DERTaggedObject;
+import com.android.internal.org.bouncycastle.asn1.x509.Extension;
+import com.android.internal.org.bouncycastle.cert.X509CertificateHolder;
+import com.android.internal.org.bouncycastle.cert.X509v3CertificateBuilder;
+import com.android.internal.org.bouncycastle.operator.ContentSigner;
+
+import java.io.ByteArrayInputStream;
+import java.security.cert.Certificate;
+import java.security.cert.CertificateFactory;
+import java.security.cert.X509Certificate;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Rewrites a hardware KeyMint attestation leaf so it describes the spoofed profile
+ * instead of the physical handset, keeping the genuine RootOfTrust.
+ *
+ * <p>This is the STRONG path: the leaf is a real TEE-produced attestation, re-signed by
+ * the keybox issuer. Only the values that must agree with the process Build are
+ * replaced. RootOfTrust (704) is preserved byte for byte, so the verified-boot
+ * measurement stays genuine and the keybox is the only thing being substituted.
+ *
+ * <p>Deliberately free of Android framework dependencies: the platform probes
+ * (profile lookup, patch levels, boot values) are supplied by the caller, which lets
+ * the exact transformation be exercised on the host.
+ *
+ * @hide
+ */
+public final class AttestationLeafRewriter {
+    private static final int TAG_OS_VERSION = 705;
+    private static final int TAG_OS_PATCHLEVEL = 706;
+    private static final int TAG_VENDOR_PATCHLEVEL = 718;
+    private static final int TAG_BOOT_PATCHLEVEL = 719;
+    private static final int TAG_ROOT_OF_TRUST = 704;
+
+    // Physical handset identifiers: never signed by a software profile.
+    private static final int TAG_ATTESTATION_ID_SERIAL = 713;
+    private static final int TAG_ATTESTATION_ID_IMEI = 714;
+    private static final int TAG_ATTESTATION_ID_MEID = 715;
+    private static final int TAG_ATTESTATION_ID_SECOND_IMEI = 723;
+
+    private AttestationLeafRewriter() {}
+
+    /** Values the rewrite needs from the platform. */
+    public static final class Inputs {
+        /** Identity tag -> UTF-8 value. Empty when the caller is not being spoofed. */
+        public Map<Integer, byte[]> identity;
+        public byte[] bootKey;
+        public byte[] bootHash;
+        /** {system (YYYYMM), vendor (YYYYMMDD), boot (YYYYMMDD)} */
+        public int[] patchLevels;
+        public int osVersion;
+    }
+
+    /**
+     * @return the replacement chain, or the input chain unchanged when it cannot (or
+     *         should not) be rewritten.
+     */
+    public static Certificate[] rewrite(Certificate[] chain, KeyBoxManager.KeyBox keybox,
+            Inputs inputs) {
+        if (chain == null || chain.length == 0 || keybox == null) return chain;
+        try {
+            if (!(chain[0] instanceof X509Certificate)) return chain;
+            X509Certificate leaf = (X509Certificate) chain[0];
+
+            byte[] extensionBytes = leaf.getExtensionValue(
+                    AttestationExtensionBuilder.ATTESTATION_OID.getId());
+            if (extensionBytes == null) return chain;
+
+            X509CertificateHolder leafHolder = new X509CertificateHolder(leaf.getEncoded());
+            Extension extension = leafHolder.getExtension(
+                    AttestationExtensionBuilder.ATTESTATION_OID);
+            if (extension == null) return chain;
+            ASN1Sequence sequence = ASN1Sequence.getInstance(
+                    extension.getExtnValue().getOctets());
+            ASN1Encodable[] encodables = sequence.toArray();
+            if (encodables.length < 8 || !(encodables[7] instanceof ASN1Sequence)) {
+                return chain;
+            }
+            ASN1Sequence teeEnforced = (ASN1Sequence) encodables[7];
+
+            // A certificate already signed by this keybox must not be re-signed on every
+            // retrieval: re-signing ECDSA produces new bytes and makes
+            // getCertificate()/getCertificateChain() diverge.
+            if (chain.length > 1 && chain[1] instanceof X509Certificate) {
+                X509Certificate storedIssuer = (X509Certificate) keybox.certificates.get(0);
+                if (Arrays.equals(chain[1].getEncoded(), storedIssuer.getEncoded())
+                        && verifies(storedIssuer, leaf)) {
+                    return chain;
+                }
+            }
+
+            Map<Integer, byte[]> identity =
+                    inputs.identity != null ? inputs.identity : java.util.Collections.emptyMap();
+
+            // Drop what gets rewritten so nothing is emitted twice, and keep the list in
+            // ascending tag order like real KeyMint output.
+            TreeMap<Integer, ASN1Encodable> ordered = new TreeMap<>();
+            ASN1Encodable originalRootOfTrust = null;
+            for (ASN1Encodable element : teeEnforced) {
+                ASN1TaggedObject tagged = (ASN1TaggedObject) element;
+                int tag = tagged.getTagNo();
+                if (tag == TAG_ROOT_OF_TRUST) {
+                    originalRootOfTrust = tagged.getBaseObject().toASN1Primitive();
+                } else if (tag == TAG_OS_VERSION || tag == TAG_OS_PATCHLEVEL
+                        || tag == TAG_VENDOR_PATCHLEVEL || tag == TAG_BOOT_PATCHLEVEL) {
+                    // Re-added below from the configured values.
+                } else if (tag == TAG_ATTESTATION_ID_SERIAL || tag == TAG_ATTESTATION_ID_IMEI
+                        || tag == TAG_ATTESTATION_ID_MEID
+                        || tag == TAG_ATTESTATION_ID_SECOND_IMEI) {
+                    // Physical handset identifiers: never signed.
+                } else if (identity.containsKey(tag)) {
+                    // Replaced below with the spoofed profile value.
+                } else {
+                    ordered.put(tag, tagged);
+                }
+            }
+
+            addRootOfTrust(ordered, originalRootOfTrust, inputs);
+            for (Map.Entry<Integer, byte[]> e : identity.entrySet()) {
+                ordered.put(e.getKey(), new DERTaggedObject(true, e.getKey(),
+                        new DEROctetString(e.getValue())));
+            }
+
+            ASN1EncodableVector orderedVector = new ASN1EncodableVector();
+            for (ASN1Encodable e : ordered.values()) orderedVector.add(e);
+            encodables[7] = new DERSequence(orderedVector);
+
+            Extension hackedExtension = new Extension(
+                    AttestationExtensionBuilder.ATTESTATION_OID, false,
+                    new DEROctetString(new DERSequence(encodables).getEncoded()));
+
+            X509v3CertificateBuilder builder = new X509v3CertificateBuilder(
+                    keybox.getIssuerSubject(),
+                    leafHolder.getSerialNumber(),
+                    leafHolder.getNotBefore(),
+                    leafHolder.getNotAfter(),
+                    leafHolder.getSubject(),
+                    leafHolder.getSubjectPublicKeyInfo());
+
+            // Keep the leaf's original extension order rather than moving the
+            // attestation extension to the front.
+            for (Object oid : leafHolder.getExtensions().getExtensionOIDs()) {
+                String oidString = oid.toString();
+                if (oidString.equals(AttestationExtensionBuilder.ATTESTATION_OID.getId())) {
+                    builder.addExtension(hackedExtension);
+                } else {
+                    builder.addExtension(leafHolder.getExtension(
+                            new ASN1ObjectIdentifier(oidString)));
+                }
+            }
+
+            ContentSigner signer = BcCrypto.newSigner(
+                    signatureAlgorithm(leaf.getSigAlgName(), keybox.algorithm),
+                    keybox.keyPair.getPrivate());
+            X509CertificateHolder builtHolder = builder.build(signer);
+            CertificateFactory certFactory = CertificateFactory.getInstance("X.509");
+            X509Certificate hackedLeaf = (X509Certificate) certFactory.generateCertificate(
+                    new ByteArrayInputStream(builtHolder.getEncoded()));
+
+            // Confirm the issuer material actually verifies the new certificate.
+            // X509Certificate.verify() needs an ECDSA JCA service the platform
+            // BouncyCastle does not register, so verify through the light API.
+            if (!verifies((X509Certificate) keybox.certificates.get(0), hackedLeaf)) {
+                return chain;
+            }
+
+            List<Certificate> result = new ArrayList<>();
+            result.add(hackedLeaf);
+            result.addAll(keybox.certificates);
+            return result.toArray(new Certificate[0]);
+        } catch (Exception e) {
+            return chain;
+        }
+    }
+
+    /**
+     * Rebuilds RootOfTrust, preserving the hardware verified-boot key and hash when the
+     * TEE supplied them, and filling in whatever is missing from the caller.
+     */
+    private static void addRootOfTrust(TreeMap<Integer, ASN1Encodable> ordered,
+            ASN1Encodable originalRootOfTrust, Inputs inputs) throws Exception {
+        byte[] bootKey = rootOfTrustOctet(originalRootOfTrust, 0);
+        if (bootKey == null) bootKey = inputs.bootKey;
+
+        byte[] bootHash = rootOfTrustOctet(originalRootOfTrust, 3);
+        if (bootHash == null) bootHash = inputs.bootHash;
+
+        // Older Keymaster versions encode RootOfTrust without verifiedBootHash.
+        // Keep the original layout instead of unconditionally adding a fourth field.
+        boolean hasBootHash = !(originalRootOfTrust instanceof ASN1Sequence)
+                || ((ASN1Sequence) originalRootOfTrust).size() >= 4;
+
+        ASN1EncodableVector rot = new ASN1EncodableVector();
+        rot.add(new DEROctetString(bootKey != null ? bootKey : new byte[32]));
+        rot.add(ASN1Boolean.TRUE);
+        rot.add(new ASN1Enumerated(0));
+        if (hasBootHash) rot.add(new DEROctetString(bootHash != null ? bootHash : new byte[32]));
+        ordered.put(TAG_ROOT_OF_TRUST, new DERTaggedObject(TAG_ROOT_OF_TRUST,
+                new DERSequence(rot)));
+
+        int[] patchLevels = inputs.patchLevels != null
+                ? inputs.patchLevels : new int[] {202404, 20240405, 20240405};
+        ordered.put(TAG_OS_VERSION,
+                new DERTaggedObject(true, TAG_OS_VERSION, new ASN1Integer(inputs.osVersion)));
+        ordered.put(TAG_OS_PATCHLEVEL,
+                new DERTaggedObject(true, TAG_OS_PATCHLEVEL, new ASN1Integer(patchLevels[0])));
+        ordered.put(TAG_VENDOR_PATCHLEVEL,
+                new DERTaggedObject(true, TAG_VENDOR_PATCHLEVEL, new ASN1Integer(patchLevels[1])));
+        ordered.put(TAG_BOOT_PATCHLEVEL,
+                new DERTaggedObject(true, TAG_BOOT_PATCHLEVEL, new ASN1Integer(patchLevels[2])));
+    }
+
+    private static byte[] rootOfTrustOctet(ASN1Encodable rootOfTrust, int index) {
+        try {
+            ASN1Sequence sequence = ASN1Sequence.getInstance(rootOfTrust);
+            if (sequence == null || sequence.size() <= index) return null;
+            byte[] value = ASN1OctetString.getInstance(sequence.getObjectAt(index)).getOctets();
+            return value.length == 0 ? null : value;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /**
+     * Whether {@code issuer} really signed {@code cert}. The digest comes from the
+     * certificate's own signature algorithm: a leaf can be SHA-256, SHA-384 or
+     * SHA-512 depending on the attested digest, and verifying a SHA-384 signature
+     * with SHA-256 would wrongly reject it.
+     */
+    private static boolean verifies(X509Certificate issuer, X509Certificate cert)
+            throws Exception {
+        return BcCrypto.verify(cert.getSigAlgName(), issuer.getPublicKey(),
+                cert.getTBSCertificate(), cert.getSignature());
+    }
+
+    /**
+     * The leaf's own signature algorithm when it fits the keybox key, otherwise the
+     * default for that key. They differ when an EC-only or RSA-only keybox signs the
+     * other algorithm's leaf, and an EC key can't produce an RSA signature.
+     */
+    static String signatureAlgorithm(String leafSigAlg, String keyboxAlgorithm) {
+        final boolean ec = "EC".equals(keyboxAlgorithm);
+        if (leafSigAlg != null) {
+            final String upper = leafSigAlg.toUpperCase(java.util.Locale.ROOT);
+            if (ec ? upper.contains("ECDSA") : upper.contains("RSA")) return leafSigAlg;
+        }
+        return ec ? "SHA256withECDSA" : "SHA256withRSA";
+    }
+
+}
