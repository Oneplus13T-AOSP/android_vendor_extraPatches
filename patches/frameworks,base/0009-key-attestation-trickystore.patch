+
+package android.security.trickystore;
+
+import android.security.pif.PlayIntegrityProfile;
+import android.util.Log;
+
+import java.security.cert.Certificate;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Android-facing adapter around {@link AttestationLeafRewriter}: resolves the profile
+ * identity, boot values and patch levels, and the keybox to sign with.
+ *
+ * @hide
+ */
+public final class CertificateHacker {
+    private static final String TAG = "CertificateHacker";
+
+    private CertificateHacker() {}
+
+    public static Certificate[] hackCertificateChain(Certificate[] chain, String[] packages) {
+        if (chain == null || chain.length == 0) return chain;
+        try {
+            if (!(chain[0] instanceof java.security.cert.X509Certificate)) return chain;
+            java.security.cert.X509Certificate leaf =
+                    (java.security.cert.X509Certificate) chain[0];
+            if (leaf.getExtensionValue(
+                    AttestationExtensionBuilder.ATTESTATION_OID.getId()) == null) {
+                return chain;
+            }
+
+            KeyBoxManager.KeyBox keybox = TrickyStoreService.getInstance()
+                    .getKeyBoxManager().getKeyboxForLeaf(leaf.getPublicKey().getAlgorithm());
+            if (keybox == null) {
+                Log.e(TAG, "No keybox for algorithm: " + leaf.getPublicKey().getAlgorithm());
+                return chain;
+            }
+
+            AttestationLeafRewriter.Inputs inputs = new AttestationLeafRewriter.Inputs();
+            inputs.identity = identityOverrides(packages);
+            inputs.bootKey = AttestationUtils.getBootKey();
+            inputs.bootHash = AttestationUtils.getBootHash();
+            inputs.patchLevels = AttestationUtils.getPatchLevels(packages);
+            inputs.osVersion = AttestationUtils.getOsVersion();
+
+            Certificate[] result = AttestationLeafRewriter.rewrite(chain, keybox, inputs);
+            if (result != chain) {
+                Log.i(TAG, "Re-signed attested leaf with the keybox");
+            }
+            return result;
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to hack certificate chain", e);
+            return chain;
+        }
+    }
+
+    /**
+     * Tag -> value map for the attested identity, from the Play Integrity profile.
+     * Empty when the caller is not one of the spoofed packages, so an unspoofed caller
+     * keeps its real, untouched hardware identity.
+     */
+    private static Map<Integer, byte[]> identityOverrides(String[] packages) {
+        Map<Integer, byte[]> overrides = new HashMap<>();
+        if (!PlayIntegrityProfile.isSpoofedPackage(packages)) return overrides;
+
+        Map<String, String> identity = PlayIntegrityProfile.getIdentity();
+        put(overrides, AttestationExtensionBuilder.TAG_ATTESTATION_ID_BRAND,
+                PlayIntegrityProfile.identityBytes(identity, "BRAND"));
+        put(overrides, AttestationExtensionBuilder.TAG_ATTESTATION_ID_DEVICE,
+                PlayIntegrityProfile.identityBytes(identity, "DEVICE"));
+        put(overrides, AttestationExtensionBuilder.TAG_ATTESTATION_ID_PRODUCT,
+                PlayIntegrityProfile.identityBytes(identity, "PRODUCT"));
+        put(overrides, AttestationExtensionBuilder.TAG_ATTESTATION_ID_MANUFACTURER,
+                PlayIntegrityProfile.identityBytes(identity, "MANUFACTURER"));
+        put(overrides, AttestationExtensionBuilder.TAG_ATTESTATION_ID_MODEL,
+                PlayIntegrityProfile.identityBytes(identity, "MODEL"));
+        return overrides;
+    }
+
+    private static void put(Map<Integer, byte[]> map, int tag, byte[] value) {
+        if (value != null && value.length > 0) map.put(tag, value);
+    }
+}
