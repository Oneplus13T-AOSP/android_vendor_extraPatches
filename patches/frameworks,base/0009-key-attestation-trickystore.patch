+package android.security.trickystore;
+
+import com.android.internal.org.bouncycastle.asn1.ASN1EncodableVector;
+import com.android.internal.org.bouncycastle.asn1.ASN1InputStream;
+import com.android.internal.org.bouncycastle.asn1.ASN1Integer;
+import com.android.internal.org.bouncycastle.asn1.ASN1Sequence;
+import com.android.internal.org.bouncycastle.asn1.DERSequence;
+import com.android.internal.org.bouncycastle.asn1.x509.AlgorithmIdentifier;
+import com.android.internal.org.bouncycastle.crypto.Digest;
+import com.android.internal.org.bouncycastle.crypto.digests.SHA1Digest;
+import com.android.internal.org.bouncycastle.crypto.digests.SHA224Digest;
+import com.android.internal.org.bouncycastle.crypto.digests.SHA256Digest;
+import com.android.internal.org.bouncycastle.crypto.digests.SHA384Digest;
+import com.android.internal.org.bouncycastle.crypto.digests.SHA512Digest;
+import com.android.internal.org.bouncycastle.crypto.params.ECDomainParameters;
+import com.android.internal.org.bouncycastle.crypto.params.ECPrivateKeyParameters;
+import com.android.internal.org.bouncycastle.crypto.params.ECPublicKeyParameters;
+import com.android.internal.org.bouncycastle.crypto.params.RSAKeyParameters;
+import com.android.internal.org.bouncycastle.crypto.signers.ECDSASigner;
+import com.android.internal.org.bouncycastle.crypto.signers.RSADigestSigner;
+import com.android.internal.org.bouncycastle.jcajce.provider.asymmetric.ec.BCECPrivateKey;
+import com.android.internal.org.bouncycastle.jcajce.provider.asymmetric.ec.BCECPublicKey;
+import com.android.internal.org.bouncycastle.jcajce.provider.asymmetric.util.ECUtil;
+import com.android.internal.org.bouncycastle.jce.ECNamedCurveTable;
+import com.android.internal.org.bouncycastle.jce.spec.ECNamedCurveParameterSpec;
+import com.android.internal.org.bouncycastle.jce.spec.ECParameterSpec;
+import com.android.internal.org.bouncycastle.operator.ContentSigner;
+import com.android.internal.org.bouncycastle.operator.DefaultSignatureAlgorithmIdentifierFinder;
+
+import java.io.ByteArrayOutputStream;
+import java.io.OutputStream;
+import java.math.BigInteger;
+import java.security.PrivateKey;
+import java.security.PublicKey;
+import java.security.interfaces.ECPrivateKey;
+import java.security.interfaces.ECPublicKey;
+import java.security.interfaces.RSAPrivateCrtKey;
+import java.security.interfaces.RSAPublicKey;
+
+/**
+ * X.509 signing and verification built directly on the BouncyCastle light API.
+ *
+ * <p>The platform's repackaged BouncyCastle deliberately does not register ECDSA as a
+ * JCA service (Android uses Conscrypt for that), so a {@code Signature.getInstance(
+ * "SHA256withECDSA", "BC")} call fails on device. It also cannot use a
+ * {@code BCECPrivateKey} through Conscrypt. Both the keybox validator and the
+ * certificate writer therefore use these primitives, which take the BC key objects
+ * directly and need no provider registration.
+ *
+ * <p>The digest follows the requested algorithm name. It must: a leaf signed
+ * {@code SHA384withECDSA} but digested with SHA-256 produces a certificate whose
+ * SignatureAlgorithm OID disagrees with the bytes actually signed, which every
+ * verifier rejects. Callers that re-sign a hardware leaf keep the leaf's own
+ * algorithm, and KeyMint leaves can be SHA-256, SHA-384 or SHA-512 depending on the
+ * key's attested digest.
+ *
+ * @hide
+ */
+final class BcCrypto {
+    private BcCrypto() {}
+
+    static ContentSigner newSigner(String algorithm, PrivateKey privateKey) throws Exception {
+        AlgorithmIdentifier sigAlgId =
+                new DefaultSignatureAlgorithmIdentifierFinder().find(algorithm);
+        Digest digest = digestFor(algorithm);
+
+        if (privateKey instanceof BCECPrivateKey) {
+            BCECPrivateKey bcKey = (BCECPrivateKey) privateKey;
+            ECParameterSpec ecSpec = bcKey.getParameters();
+            if (ecSpec == null) {
+                ECNamedCurveParameterSpec namedSpec = ECNamedCurveTable.getParameterSpec("secp256r1");
+                ecSpec = namedSpec;
+            }
+            ECDomainParameters domainParams = new ECDomainParameters(
+                    ecSpec.getCurve(), ecSpec.getG(), ecSpec.getN(), ecSpec.getH());
+            return new EcSigner(sigAlgId, digest,
+                    new ECPrivateKeyParameters(bcKey.getD(), domainParams));
+        }
+        if (privateKey instanceof ECPrivateKey) {
+            return new EcSigner(sigAlgId, digest,
+                    (ECPrivateKeyParameters) ECUtil.generatePrivateKeyParameter(privateKey));
+        }
+        if (privateKey instanceof RSAPrivateCrtKey) {
+            RSAPrivateCrtKey rsa = (RSAPrivateCrtKey) privateKey;
+            return new RsaSigner(sigAlgId, digest,
+                    new RSAKeyParameters(true, rsa.getModulus(), rsa.getPrivateExponent()));
+        }
+        throw new IllegalArgumentException("Unsupported key type: " + privateKey.getClass());
+    }
+
+    /** Signs {@code data}, returning the DER-encoded signature. */
+    static byte[] sign(String algorithm, PrivateKey privateKey, byte[] data) throws Exception {
+        ContentSigner signer = newSigner(algorithm, privateKey);
+        try (OutputStream out = signer.getOutputStream()) {
+            out.write(data);
+        }
+        return signer.getSignature();
+    }
+
+    /**
+     * Verifies a DER signature over {@code data}, using the digest named by
+     * {@code algorithm} (for example {@code SHA256withECDSA}).
+     */
+    static boolean verify(String algorithm, PublicKey publicKey, byte[] data, byte[] signature)
+            throws Exception {
+        Digest digest = digestFor(algorithm);
+        if (publicKey instanceof ECPublicKey) {
+            ECPublicKeyParameters params;
+            if (publicKey instanceof BCECPublicKey) {
+                BCECPublicKey bcKey = (BCECPublicKey) publicKey;
+                ECParameterSpec spec = bcKey.getParameters();
+                params = new ECPublicKeyParameters(bcKey.getQ(),
+                        new ECDomainParameters(spec.getCurve(), spec.getG(), spec.getN(),
+                                spec.getH()));
+            } else {
+                params = (ECPublicKeyParameters) ECUtil.generatePublicKeyParameter(publicKey);
+            }
+            ECDSASigner verifier = new ECDSASigner();
+            verifier.init(false, params);
+            BigInteger r;
+            BigInteger s;
+            try (ASN1InputStream in = new ASN1InputStream(signature)) {
+                ASN1Sequence seq = ASN1Sequence.getInstance(in.readObject());
+                r = ASN1Integer.getInstance(seq.getObjectAt(0)).getValue();
+                s = ASN1Integer.getInstance(seq.getObjectAt(1)).getValue();
+            }
+            byte[] hash = digestOf(digest, data);
+            return verifier.verifySignature(hash, r, s);
+        }
+        if (publicKey instanceof RSAPublicKey) {
+            RSAPublicKey rsa = (RSAPublicKey) publicKey;
+            RSADigestSigner verifier = new RSADigestSigner(digest);
+            verifier.init(false,
+                    new RSAKeyParameters(false, rsa.getModulus(), rsa.getPublicExponent()));
+            verifier.update(data, 0, data.length);
+            return verifier.verifySignature(signature);
+        }
+        throw new IllegalArgumentException("Unsupported key type: " + publicKey.getClass());
+    }
+
+    /** BouncyCastle's Digest has no one-shot helper, so wrap the two calls. */
+    private static byte[] digestOf(Digest digest, byte[] data) {
+        digest.update(data, 0, data.length);
+        byte[] out = new byte[digest.getDigestSize()];
+        digest.doFinal(out, 0);
+        return out;
+    }
+
+    /**
+     * Maps an X.509 signature algorithm name to the digest it signs with. An unknown
+     * name is rejected rather than silently defaulted, so a mismatch cannot slip
+     * through as a valid signature.
+     */
+    private static Digest digestFor(String algorithm) {
+        String upper = algorithm == null ? "" : algorithm.toUpperCase(java.util.Locale.ROOT);
+        if (upper.contains("SHA224")) return new SHA224Digest();
+        if (upper.contains("SHA256")) return new SHA256Digest();
+        if (upper.contains("SHA384")) return new SHA384Digest();
+        if (upper.contains("SHA512")) return new SHA512Digest();
+        if (upper.contains("SHA1")) return new SHA1Digest();
+        throw new IllegalArgumentException("Unsupported signature digest: " + algorithm);
+    }
+
+    private static final class EcSigner implements ContentSigner {
+        private final AlgorithmIdentifier algId;
+        private final Digest digest;
+        private final ECPrivateKeyParameters keyParam;
+        private final ByteArrayOutputStream stream = new ByteArrayOutputStream();
+
+        EcSigner(AlgorithmIdentifier algId, Digest digest, ECPrivateKeyParameters keyParam) {
+            this.algId = algId;
+            this.digest = digest;
+            this.keyParam = keyParam;
+        }
+
+        @Override
+        public AlgorithmIdentifier getAlgorithmIdentifier() {
+            return algId;
+        }
+
+        @Override
+        public OutputStream getOutputStream() {
+            return stream;
+        }
+
+        @Override
+        public byte[] getSignature() {
+            try {
+                byte[] hash = digestOf(digest, stream.toByteArray());
+                ECDSASigner signer = new ECDSASigner();
+                signer.init(true, keyParam);
+                BigInteger[] sig = signer.generateSignature(hash);
+                ASN1EncodableVector v = new ASN1EncodableVector();
+                v.add(new ASN1Integer(sig[0]));
+                v.add(new ASN1Integer(sig[1]));
+                return new DERSequence(v).getEncoded();
+            } catch (Exception e) {
+                throw new RuntimeException("Failed to generate ECDSA signature", e);
+            }
+        }
+    }
+
+    private static final class RsaSigner implements ContentSigner {
+        private final AlgorithmIdentifier algId;
+        private final Digest digest;
+        private final RSAKeyParameters keyParam;
+        private final ByteArrayOutputStream stream = new ByteArrayOutputStream();
+
+        RsaSigner(AlgorithmIdentifier algId, Digest digest, RSAKeyParameters keyParam) {
+            this.algId = algId;
+            this.digest = digest;
+            this.keyParam = keyParam;
+        }
+
+        @Override
+        public AlgorithmIdentifier getAlgorithmIdentifier() {
+            return algId;
+        }
+
+        @Override
+        public OutputStream getOutputStream() {
+            return stream;
+        }
+
+        @Override
+        public byte[] getSignature() {
+            try {
+                RSADigestSigner signer = new RSADigestSigner(digest);
+                signer.init(true, keyParam);
+                byte[] data = stream.toByteArray();
+                signer.update(data, 0, data.length);
+                return signer.generateSignature();
+            } catch (Exception e) {
+                throw new RuntimeException("Failed to generate RSA signature", e);
+            }
+        }
+    }
+}
