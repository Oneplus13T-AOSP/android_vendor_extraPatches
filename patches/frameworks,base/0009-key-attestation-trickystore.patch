+package android.security.trickystore;
+
+import android.app.ActivityThread;
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.util.Log;
+
+import com.android.internal.org.bouncycastle.asn1.ASN1ObjectIdentifier;
+import com.android.internal.org.bouncycastle.asn1.DEROctetString;
+import com.android.internal.org.bouncycastle.asn1.x500.X500Name;
+import com.android.internal.org.bouncycastle.asn1.x509.KeyUsage;
+
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.MessageDigest;
+import java.security.cert.Certificate;
+import java.security.cert.X509Certificate;
+import java.security.spec.ECGenParameterSpec;
+import java.security.spec.RSAKeyGenParameterSpec;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.security.auth.x500.X500Principal;
+
+/**
+ * Builds a complete software attestation certificate chain signed by the active
+ * keybox key. Used when the TEE cannot produce a usable attestation at all.
+ *
+ * <p>The identity tags (710/711/712/716/717) always come from the Play Integrity
+ * profile, never from the caller-supplied attestation request, because GMS asks
+ * for attestation with the handset's own ODM properties while the process Build
+ * carries the spoofed profile. Signing the request values would make the
+ * certificate contradict the Build fields Play Integrity cross-checks.
+ *
+ * <p>Serial, IMEI, MEID and second IMEI are never signed: a software attestation
+ * cannot legitimately claim the physical handset identifiers.
+ *
+ * @hide
+ */
+public final class CertificateGenerator {
+    private static final String TAG = "CertificateGenerator";
+    private static final int MAX_ATTESTATION_CHALLENGE_SIZE = 128;
+
+    public static final ASN1ObjectIdentifier ATTESTATION_OID =
+            new ASN1ObjectIdentifier("1.3.6.1.4.1.11129.2.1.17");
+
+    // KeyMint attestation ID tags for the attested device identity.
+    public static final int TAG_ATTESTATION_ID_BRAND = 710;
+    public static final int TAG_ATTESTATION_ID_DEVICE = 711;
+    public static final int TAG_ATTESTATION_ID_PRODUCT = 712;
+    public static final int TAG_ATTESTATION_ID_MANUFACTURER = 716;
+    public static final int TAG_ATTESTATION_ID_MODEL = 717;
+
+    private CertificateGenerator() {}
+
+    /** @hide */
+    public static class KeyGenParameters {
+        public int keySize;
+        public int algorithm;
+        public BigInteger certificateSerial;
+        public Date certificateNotBefore;
+        public Date certificateNotAfter;
+        public X500Principal certificateSubject;
+        public BigInteger rsaPublicExponent;
+        public int ecCurve;
+        public String ecCurveName;
+        public List<Integer> purpose = new ArrayList<>();
+        public List<Integer> digest = new ArrayList<>();
+        public List<Integer> rsaOaepMgfDigest = new ArrayList<>();
+        public List<Integer> padding = new ArrayList<>();
+        public String[] packages;
+        public byte[] attestationChallenge;
+        public byte[] brand;
+        public byte[] device;
+        public byte[] product;
+        public byte[] manufacturer;
+        public byte[] model;
+
+        public String getEcCurveName() {
+            if (ecCurveName != null) return ecCurveName;
+            switch (keySize) {
+                case 224: return "secp224r1";
+                case 256: return "secp256r1";
+                case 384: return "secp384r1";
+                case 521: return "secp521r1";
+                default: return "secp256r1";
+            }
+        }
+    }
+
+    public static KeyPair generateKeyPair(KeyGenParameters params) {
+        try {
+            KeyPairGenerator kpg;
+            if (params.algorithm == 3) {
+                kpg = KeyPairGenerator.getInstance("EC");
+                kpg.initialize(new ECGenParameterSpec(params.getEcCurveName()));
+            } else if (params.algorithm == 1) {
+                kpg = KeyPairGenerator.getInstance("RSA");
+                kpg.initialize(new RSAKeyGenParameterSpec(
+                    params.keySize,
+                    params.rsaPublicExponent != null ? params.rsaPublicExponent
+                                                     : RSAKeyGenParameterSpec.F4
+                ));
+            } else {
+                Log.e(TAG, "Unsupported algorithm: " + params.algorithm);
+                return null;
+            }
+            return kpg.generateKeyPair();
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to generate key pair", e);
+            return null;
+        }
+    }
+
+    public static List<Certificate> generateCertificateChain(
+            KeyPair keyPair,
+            KeyGenParameters params,
+            int uid) {
+        // Validate attestation challenge size (real TEE rejects oversized challenges)
+        if (params.attestationChallenge != null &&
+            params.attestationChallenge.length > MAX_ATTESTATION_CHALLENGE_SIZE) {
+            Log.e(TAG, "Attestation challenge too large: " +
+                  params.attestationChallenge.length + " bytes (max " +
+                  MAX_ATTESTATION_CHALLENGE_SIZE + ")");
+            return null;
+        }
+
+        if (keyPair == null || keyPair.getPublic() == null
+                || (params.algorithm != 3 && params.algorithm != 1)) {
+            Log.e(TAG, "Invalid key pair or unsupported requested algorithm");
+            return null;
+        }
+        KeyBoxManager keyboxManager = TrickyStoreService.getInstance().getKeyBoxManager();
+        String algorithm = params.algorithm == 3 ? "EC" : "RSA";
+        if (!algorithm.equalsIgnoreCase(keyPair.getPublic().getAlgorithm())) {
+            Log.e(TAG, "Requested algorithm differs from generated key material");
+            return null;
+        }
+        KeyBoxManager.KeyBox keybox = keyboxManager.getKeyboxForLeaf(algorithm);
+
+        if (keybox == null) {
+            Log.e(TAG, "No keybox found for algorithm: " + algorithm);
+            return null;
+        }
+
+        try {
+            X500Name issuer = keybox.getIssuerSubject();
+
+            X509Certificate leaf = buildCertificate(keyPair, keybox, params, issuer, uid);
+
+            List<Certificate> chain = new ArrayList<>();
+            chain.add(leaf);
+            chain.addAll(keybox.certificates);
+            return chain;
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to generate certificate chain", e);
+            return null;
+        }
+    }
+
+    private static X509Certificate buildCertificate(
+            KeyPair keyPair,
+            KeyBoxManager.KeyBox keybox,
+            KeyGenParameters params,
+            X500Name issuer,
+            int uid) throws Exception {
+
+        BigInteger serial = params.certificateSerial != null ?
+            params.certificateSerial : BigInteger.ONE;
+        Date notBefore = params.certificateNotBefore != null
+                ? params.certificateNotBefore : new Date();
+        Date notAfter = params.certificateNotAfter != null
+                ? params.certificateNotAfter
+                : ((X509Certificate) keybox.certificates.get(0)).getNotAfter();
+        X500Name subject = params.certificateSubject != null
+                ? X500Name.getInstance(params.certificateSubject.getEncoded())
+                : new X500Name("CN=Android Keystore Key");
+
+        return LeafCertificateBuilder.build(
+                keyPair, keybox, serial, notBefore, notAfter, subject,
+                keyUsageFromPurposes(params.purpose),
+                buildAttestExtension(params, uid));
+    }
+
+    private static Extension buildAttestExtension(KeyGenParameters params, int uid) {
+        // Validate attestation challenge size (real TEE rejects oversized challenges)
+        if (params.attestationChallenge != null &&
+            params.attestationChallenge.length > MAX_ATTESTATION_CHALLENGE_SIZE) {
+            Log.e(TAG, "Attestation challenge too large: " + params.attestationChallenge.length +
+                  " bytes (max " + MAX_ATTESTATION_CHALLENGE_SIZE + ")");
+            return null;
+        }
+        try {
+            // Fetch the patch configuration once, not three times during one leaf.
+            final int[] patchLevels = AttestationUtils.getPatchLevels(params.packages);
+
+            AttestationExtensionBuilder.Params builderParams =
+                    new AttestationExtensionBuilder.Params();
+            builderParams.algorithm = params.algorithm;
+            builderParams.keySize = params.keySize;
+            builderParams.ecCurve = params.ecCurve;
+            builderParams.rsaPublicExponent = params.rsaPublicExponent;
+            builderParams.purpose = params.purpose;
+            builderParams.digest = params.digest;
+            builderParams.padding = params.padding;
+            builderParams.rsaOaepMgfDigest = params.rsaOaepMgfDigest;
+            builderParams.challenge = params.attestationChallenge;
+            builderParams.bootKey = AttestationUtils.getBootKey();
+            builderParams.bootHash = AttestationUtils.getBootHash();
+            builderParams.patchLevels = patchLevels;
+            builderParams.osVersion = AttestationUtils.getOsVersion();
+            builderParams.attestVersion = AttestationUtils.getAttestVersion();
+            builderParams.keymasterVersion = AttestationUtils.getKeymasterVersion();
+            builderParams.brand = params.brand;
+            builderParams.device = params.device;
+            builderParams.product = params.product;
+            builderParams.manufacturer = params.manufacturer;
+            builderParams.model = params.model;
+            try {
+                builderParams.applicationId = createApplicationId(uid, params.packages);
+            } catch (Throwable e) {
+                Log.w(TAG, "Failed to create application ID", e);
+            }
+            return AttestationExtensionBuilder.build(builderParams);
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to build attestation extension", e);
+            throw new RuntimeException(e);
+        }
+    }
+
+    /**
+     * Same purpose -> KeyUsage mapping stock KeyMint uses. keyCertSign is only
+     * correct for ATTEST_KEY; using it for every key is a fingerprint.
+     */
+    private static int keyUsageFromPurposes(List<Integer> purposes) {
+        int bits = 0;
+        for (int purpose : purposes) {
+            switch (purpose) {
+                case 2: bits |= KeyUsage.digitalSignature; break;  // SIGN
+                case 1: bits |= KeyUsage.dataEncipherment; break;  // DECRYPT
+                case 5: bits |= KeyUsage.keyEncipherment; break;   // WRAP_KEY
+                case 6: bits |= KeyUsage.keyAgreement; break;      // AGREE_KEY
+                case 7: bits |= KeyUsage.keyCertSign; break;       // ATTEST_KEY
+                default: break;
+            }
+        }
+        return bits;
+    }
+
+    private static ASN1OctetString createApplicationId(int uid, String[] knownPackages)
+            throws Throwable {
+        Context context = ActivityThread.currentApplication();
+        if (context == null && ActivityThread.currentActivityThread() != null) {
+            context = ActivityThread.currentActivityThread().getSystemContext();
+        }
+        if (context == null) {
+            throw new IllegalStateException("createApplicationId: no context");
+        }
+
+        PackageManager pm = context.getPackageManager();
+        if (pm == null) {
+            throw new IllegalStateException("createApplicationId: PackageManager not found!");
+        }
+
+        String[] packages = knownPackages;
+        if (packages == null || packages.length == 0) {
+            packages = pm.getPackagesForUid(uid);
+        }
+        if (packages == null || packages.length == 0) {
+            throw new IllegalStateException("No packages found for UID: " + uid);
+        }
+
+        int size = packages.length;
+        ASN1Encodable[] packageInfoAA = new ASN1Encodable[size];
+        Set<Digest> signatures = new HashSet<>();
+        MessageDigest dg = MessageDigest.getInstance("SHA-256");
+
+        for (int i = 0; i < size; i++) {
+            String name = packages[i];
+            PackageInfo info = pm.getPackageInfo(name, PackageManager.GET_SIGNATURES);
+            ASN1Encodable[] arr = new ASN1Encodable[2];
+            arr[0] = new DEROctetString(name.getBytes(StandardCharsets.UTF_8));
+            arr[1] = new ASN1Integer(info.getLongVersionCode());
+            packageInfoAA[i] = new DERSequence(arr);
+
+            if (info.signatures != null) {
+                for (Signature s : info.signatures) {
+                    signatures.add(new Digest(dg.digest(s.toByteArray())));
+                }
+            }
+        }
+
+        ASN1Encodable[] signaturesAA = new ASN1Encodable[signatures.size()];
+        int i = 0;
+        for (Digest d : signatures) {
+            signaturesAA[i++] = new DEROctetString(d.digest);
+        }
+
+        ASN1Encodable[] applicationIdAA = new ASN1Encodable[2];
+        applicationIdAA[0] = new DERSet(packageInfoAA);
+        applicationIdAA[1] = new DERSet(signaturesAA);
+
+        return new DEROctetString(new DERSequence(applicationIdAA).getEncoded());
+    }
+
+    private static final class Digest {
+        final byte[] digest;
+
+        Digest(byte[] digest) {
+            this.digest = digest;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof Digest && java.util.Arrays.equals(digest, ((Digest) o).digest);
+        }
+
+        @Override
+        public int hashCode() {
+            return java.util.Arrays.hashCode(digest);
+        }
+    }
+}
