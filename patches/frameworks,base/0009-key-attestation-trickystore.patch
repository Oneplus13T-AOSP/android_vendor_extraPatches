+
+package android.security.trickystore;
+
+import com.android.internal.org.bouncycastle.asn1.x500.X500Name;
+import com.android.internal.org.bouncycastle.asn1.x509.Extension;
+import com.android.internal.org.bouncycastle.asn1.x509.KeyUsage;
+import com.android.internal.org.bouncycastle.asn1.x509.SubjectPublicKeyInfo;
+import com.android.internal.org.bouncycastle.cert.X509CertificateHolder;
+import com.android.internal.org.bouncycastle.cert.X509v3CertificateBuilder;
+import com.android.internal.org.bouncycastle.operator.ContentSigner;
+
+import java.io.ByteArrayInputStream;
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.cert.CertificateFactory;
+import java.security.cert.X509Certificate;
+import java.util.Date;
+
+/**
+ * Assembles and signs one attestation leaf certificate with a keybox issuer key.
+ *
+ * <p>Free of Android framework dependencies so the produced certificate can be
+ * verified on the host, which matters because the platform BouncyCastle cannot be
+ * used for ECDSA through the JCA.
+ *
+ * @hide
+ */
+public final class LeafCertificateBuilder {
+    private LeafCertificateBuilder() {}
+
+    /**
+     * @param keyUsage       X.509 key usage bits, or 0 to omit the extension
+     * @param attestation    the KeyDescription extension to embed
+     * @throws java.security.SignatureException if the issuer does not verify the result
+     */
+    public static X509Certificate build(
+            KeyPair subject,
+            KeyBoxManager.KeyBox keybox,
+            BigInteger serial,
+            Date notBefore,
+            Date notAfter,
+            X500Name subjectName,
+            int keyUsage,
+            Extension attestation) throws Exception {
+
+        X509v3CertificateBuilder builder = new X509v3CertificateBuilder(
+                keybox.getIssuerSubject(),
+                serial,
+                notBefore,
+                notAfter,
+                subjectName,
+                SubjectPublicKeyInfo.getInstance(subject.getPublic().getEncoded()));
+
+        if (keyUsage != 0) {
+            builder.addExtension(Extension.keyUsage, true, new KeyUsage(keyUsage));
+        }
+        builder.addExtension(attestation);
+
+        // Sign with the keybox's key, which is not the leaf's when the keybox only has
+        // the other algorithm (see KeyBoxManager.getKeyboxForLeaf()).
+        boolean ecIssuer = "EC".equals(keybox.algorithm);
+        String sigAlg = ecIssuer ? "SHA256withECDSA" : "SHA256withRSA";
+        // BcCrypto signs through the BC light API: the platform provider exposes no
+        // ECDSA JCA service, so JcaContentSignerBuilder("SHA256withECDSA") cannot work.
+        ContentSigner signer = BcCrypto.newSigner(sigAlg, keybox.keyPair.getPrivate());
+
+        X509CertificateHolder holder = builder.build(signer);
+        X509Certificate result = (X509Certificate) CertificateFactory.getInstance("X.509")
+                .generateCertificate(new ByteArrayInputStream(holder.getEncoded()));
+
+        if (!BcCrypto.verify(result.getSigAlgName(),
+                ((X509Certificate) keybox.certificates.get(0)).getPublicKey(),
+                result.getTBSCertificate(), result.getSignature())) {
+            throw new java.security.SignatureException(
+                    "Generated leaf does not verify against the keybox issuer");
+        }
+        return result;
+    }
+}
diff --git a/core/java/android/security/trickystore/TrickyStoreService.java b/core/java/android/security/trickystore/TrickyStoreService.java
new file mode 100644
index 000000000000..6217a9b86353
--- /dev/null
+++ b/core/java/android/security/trickystore/TrickyStoreService.java
@@ -0,0 +1,390 @@
+/*
+ * Copyright (C) 2025-2026 AxionOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
