From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FontMod <fontmod@localhost>
Date: Sun, 1 Nov 2026 18:00:00 +0900
Subject: [PATCH] custom: include standalone FontMod in common product config

Keep the app in the separate vendor/fontmod project and inherit its
product packages from the shared PixelOS configuration.

Base: 77bcd52fc22f6fdb792dea52b5ccde3be39ef250
---
 config/common.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/config/common.mk b/config/common.mk
--- a/config/common.mk
+++ b/config/common.mk
@@ -1,4 +1,7 @@
 # Common PixelOS stuff.
+
+# FontMod
+$(call inherit-product, vendor/fontmod/fontmod.mk)
 
 # Bootanimation
 ifeq ($(strip $(TARGET_SCREEN_WIDTH)),)
-- 
