From e4d5cdebcc5f59ac7ce3a5900f9825457e4a5b0e Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Mon, 2 Nov 2026 01:58:17 +0900
Subject: [PATCH] highway: provide the vendor variant required by libjxl

libjxl exposes vendor variants and links libhwy in both its static and
shared variants. Make that dependency available in the same image.

Base: 94b90ab8cb9df9b3719a64751ea2fcb62caa3391

Validation: source and dependency inspection only; no build run.
---
 Android.bp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Android.bp b/Android.bp
index b2febd1..c907cd6 100644
--- a/Android.bp
+++ b/Android.bp
@@ -35,6 +35,7 @@ cc_library_headers {
 cc_library {
     name: "libhwy",
     host_supported: true,
+    vendor_available: true,
     sdk_version: "current",
     stl: "c++_shared",
     export_include_dirs: [
-- 
