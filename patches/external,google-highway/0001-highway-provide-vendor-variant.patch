From 0ece54c3c2b1ff2168a877373eee1b8866dfe899 Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Thu, 12 Nov 2026 15:09:03 +0900
Subject: [PATCH] highway: provide the vendor variant required by libjxl

libjxl is vendor_available, so Soong also builds a vendor variant of it.
libjxl links libhwy in both its static and shared variants, which means
libhwy needs a vendor variant as well.

Without this, Soong analysis fails with:

  dependency "libhwy" of "libjxl" missing variant:
    os:android,image:vendor,link:static

Change-Id: I639df1adbadd0c8f0f2b6a7c49ad20f95ba26e1b
---
 Android.bp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Android.bp b/Android.bp
index b2febd1e..4f62e86b 100644
--- a/Android.bp
+++ b/Android.bp
@@ -35,6 +35,10 @@ cc_library_headers {
 cc_library {
     name: "libhwy",
     host_supported: true,
+    // libjxl is vendor_available, so Soong also builds a vendor variant of it.
+    // libjxl links libhwy in both its static and shared variants, which means
+    // this module needs a vendor variant as well.
+    vendor_available: true,
     sdk_version: "current",
     stl: "c++_shared",
     export_include_dirs: [
-- 
