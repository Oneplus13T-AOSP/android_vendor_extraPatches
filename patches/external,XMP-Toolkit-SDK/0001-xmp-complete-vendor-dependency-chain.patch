From 9edffbebf56ecbe42425214b06004e940233ed97 Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Mon, 2 Nov 2026 01:58:17 +0900
Subject: [PATCH] xmp: expose the complete libdng_sdk vendor dependency chain

libdng_sdk requires xmp_toolkit_sdk, which in turn whole-links zuid_md5.
Expose both vendor variants so the dependency chain is complete.
The remaining explicit dependency, libexpat, is already vendor available.

Base: 45acb237cd13c19708f963247c732250cd43a4a5

Validation: source and dependency inspection only; no build run.
---
 Android.bp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Android.bp b/Android.bp
index 285475c..2770b55 100644
--- a/Android.bp
+++ b/Android.bp
@@ -16,6 +16,7 @@ license {
 cc_library {
     name: "zuid_md5",
     host_supported: true,
+    vendor_available: true,
     sdk_version: "current",
     stl: "c++_shared",
     target: {
@@ -37,6 +38,7 @@ cc_library {
 cc_library {
     name: "xmp_toolkit_sdk",
     host_supported: true,
+    vendor_available: true,
     sdk_version: "current",
     stl: "c++_shared",
     export_include_dirs: [
-- 
2.56.0

